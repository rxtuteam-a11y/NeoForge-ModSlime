	quest.2AFA42AFC1F22F78.title: "Charybdis suit"
	quest.2B3C4D5E6F7A8901.title: "Poison Taratect"
	quest.2B40902E17F81207.quest_desc: [
		"After entering the Foundation Building stage, the player will randomly obtain a spiritual root."
		"Different spiritual roots grant the corresponding attribute's lower elemental spirit and bring their own unique ability enhancements."
		""
		"&4Fire Root&r"
		"Grants the fire-type lower elemental spirit."
		"Effect:"
		"Improves control over heat during alchemy."
		"Being close to an alchemy furnace can further reduce the time needed for refining."
		""
		"&9Water Root&r"
		"Grants the water-type lower elemental spirit."
		"Effect:"
		"Provides continuous recovery ability."
		"Passively restores health and Magicule."
		""
		"&bWind Root&r"
		"Grants the wind-type lower elemental spirit."
		"Effect:"
		"Provides movement enhancement."
		"Directly increases player movement speed."
		""
		"&#93452AEarth Root&r"
		"Grants the earth-type lower elemental spirit."
		"Effect:"
		"Provides basic combat and resistance abilities corresponding to the earth spirit."
		""
		"&fVoid Root"
		"Grants the space-type lower elemental spirit."
		"Effect:"
		"Provides basic abilities such as spatial shifting and spatial resistance."
	]
	quest.2B51A873B4182555.quest_desc: [
		"&#FFED54Hyperlink:&r"
		"[ { \"text\": \"How Artifacts Work\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4DB740093C0BA804\" } } ]"
		""
		"Default Effects"
		"&5Effect 1: Rising Inferno"
		"While the wearer is in combat, Fire damage increases by 1% over time."
		"Rising Inferno gains one stack every 3 seconds, stacking up to 20% increased Fire damage."
		"&5Effect 2: Hell Flare Amplification"
		"Increases Limited Hell Flare damage by 50%."
		"&5Effect 3: Commander's Controlled Rage"
		"Unlocks when the wearer possesses the Unique Skill Commander."
		"Commander's Controlled Rage upgrades Inspire and reduces Magicule costs based on the wearer's current MP/Magicule."
		"The lower the wearer's current MP/Magicule, the stronger the Magicule cost reduction."
		""
		"Refinement Bonuses"
		"Rising Inferno Scaling"
		"Each refinement allocated to Rising Inferno reduces the time between Fire damage stacks by 0.25 seconds."
		"Maximum: Rising Inferno can receive up to 2 refinements, reducing the stack timer to 2.5 seconds."
		"Hell Flare Amplification Scaling"
		"Each refinement allocated to Hell Flare Amplification increases Limited Hell Flare damage by an additional 10%."
		"Maximum: At +3 refinement, Hell Flare Amplification can increase Limited Hell Flare damage by up to 80%."
		"Commander's Controlled Rage Scaling"
		"Each refinement allocated to Commander's Controlled Rage changes the missing Magicule threshold used for each Magicule cost reduction step by 5%."
	]
	quest.2B51A873B4182555.title: "&6【Artifact】&fGrade 1 Ancient Artifact"
	quest.2B5B4F80FF58C22F.quest_desc: ["If you are barely dealing any damage, craft a &4Hot Spring Stone Sword&r! It will make the fight much easier."]
	quest.2B5B4F80FF58C22F.title: "Giant Moonvine? Burn It Down!"
	quest.2B64F0E323A0A8EA.quest_desc: [
		"&l[Active - Hold]:&r Hold to lock the player into a 360° view, slightly farther out than the normal third-person view. While active, grants +0.02 movement speed, +0.5 swimming speed, +0.1 attack speed, and mining speed equivalent to Haste I. If you have Presence Sense, it increases its level by 1 and its radius by 10 blocks. After mastery, it can be toggled and grants a 10% dodge chance. Holding the skill instead doubles the movement speed and Presence Sense radius bonuses. Consumes 10 Magicules every 20 ticks."
		""
		"&6Requires more than 5,000 EP."
	]
	quest.2B64F0E323A0A8EA.quest_subtitle: "If there is a frame, you won’t hit it?"
	quest.2B64F0E323A0A8EA.title: "&6【Tips】&rEssential Early-Game Skill 【All-seeing Eye】"
	quest.2B8533422784771E.quest_desc: [
		"Gain basic immunity to poison or reduce its effects"
		"&6&lPoison Resistance [Unlock Codex]"
		"{image:ablazeaqzlcz:textures/ftb/curios/antidote_vessel.png width:50 height:80 align:left}"
	]
	quest.2B8533422784771E.quest_subtitle: "Antidote"
	quest.2C2C9E868AC963D5.quest_desc: [
		"{image:ablazeaqzlcz:textures/ftb/quest.png width:155 height:100 align:center}"
		"Complete these quests to obtain \"Reincarnation Essence\". This system is tied to reincarnation: meet its requirements to reincarnate successfully and obtain a new Unique Skill. &6Required commissions and obtaining Reincarnation Essence (RE) are mandatory, as they are among the Reset Counter quest requirements.&r"
		""
		"Reincarnation increases your Soul Level, with racial reincarnation providing an even greater increase. Higher Soul Levels make you stronger and unlock additional bonuses."
		"Currently available bonuses:"
		"1. Less mastery lost from locked skills when resetting"
		"2. Higher chances of rarer commissions"
		"3. A chance to receive additional commissions"
	]
	quest.2C2C9E868AC963D5.quest_subtitle: "You Need to Understand This System"
	quest.2C746CE4537BB8EB.quest_desc: [
		"The Natural Altar collects Aura from an area of roughly 20 blocks and can store up to about 500,000 Aura."
		"Main infusion recipes:"
		"Iron Ingot → Infused Iron Ingot"
		"Stone → Infused Rock"
		""
		"More recipes can be viewed in EMI (JEI)."
	]
	quest.2C746CE4537BB8EB.quest_subtitle: "Absorb Natural Aura"
	quest.2D67CE51F7110224.quest_desc: "Right-click to place it on the ground. It will then absorb nearby Aura and convert it into various ores. This requires a large amount of Aura."
	quest.2D67CE51F7110224.quest_subtitle: "Convert nearby stone into various ores"
	quest.2DA0976EFC249F4A.title: "Defeat the Night Lich"
	quest.2DB4047F56352F3B.quest_subtitle: "It's time for you to become a Demon Lord"
	quest.2DB4047F56352F3B.title: "&6【Main Story】&rEP reaches 200,000"
	quest.2DE2EA8E74C55722.quest_subtitle: "[Click to submit the mission after obtaining the Hero Egg]"
	quest.2DE2EA8E74C55722.title: "&6【Hero Route】&rObtain the Hero Egg"
	quest.2E0D203C4166C35C.quest_desc: [
		"Reincarnation Essence is a required resource for reincarnation. Reaching the required amount is one of the conditions for reincarnating. Your Reincarnation Essence is cleared after reincarnation, and the amount required increases with each reincarnation."
		""
		"&cThe Reset Counter allows players to obtain more &#090A00Unique Skills and lock more Unique Skills&r.&r"
		""
		"Once you meet the Reset Counter requirements, use a Character Reset Scroll to advance."
		"&6Related information:&r"
		"[ { \"text\": \"Reset Counter Quest\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6533548BC66DB5E7\" } } ]"
		"[ { \"text\": \"Honor Commissions and Soul Levels\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"2C2C9E868AC963D5\" } } ]"
	]
	quest.2E0D203C4166C35C.quest_subtitle: "Can only be obtained by completing honorary commissions"
	quest.2E3BE90938EB4D75.quest_subtitle: "Probability of dropping"
	quest.2E52B4F14A7EE943.quest_desc: ["Dragon eggs can be dropped by female flying dragons whose growth stage reaches level 4 and above, and the number ranges from 0 to 3.&6All are generated underground."]
	quest.2E52B4F14A7EE943.quest_subtitle: "The dragons on the ground are too small!"
	quest.2E52B4F14A7EE943.title: "How to get dragon eggs?"
	quest.2E8290C05CD68FB4.quest_subtitle: "[Click to submit the quest after obtaining the corresponding spirit]"
	quest.2E8290C05CD68FB4.title: "Water Spirit·Low Level"
	quest.2EF2C89BAEBD2D85.quest_desc: "&6You can find this place using coordinates obtained by trading with the Time Warden"
	quest.2EF2C89BAEBD2D85.quest_subtitle: "The underground workshop where ancient clockmakers built their mechanical army"
	quest.2F5EA5DA32178D88.quest_subtitle: "Obtain through reincarnation or other methods"
	quest.2F5EA5DA32178D88.title: "&6【Advanced】&fObtain the Great Sage Unique Skill"
	quest.2F8F7C3215DD9101.quest_desc: [
		"A weapon with a high attack range, the right click can also launch thunder balls, which can directly cause frontal damage to the Flame Demon."
		"&6Default EP: 0"
		"&6Killing creatures can increase EP, but weapons cannot evolve."
	]
	quest.2F8F7C3215DD9101.quest_subtitle: "Harpoon that fires lightning strikes"
	quest.2F9A16CFA0549969.quest_subtitle: "Has spiky scales and tough skin"
	quest.2F9A16CFA0549969.title: "The powerful snake monster in the sealed cave"
	quest.3072ADF52B960186.title: "&#FF6854【Recycle】&fFlame Essence"
	quest.3091985C0E95C53F.quest_desc: [
		"Trade with a master-level Cartographer for a map to the school structure. After the boss is defeated there, it respawns after a 40-minute cooldown. It also has a chance to spawn in stone houses in plains villages, and can appear in the wild."
		""
		"During an air raid in World War II, Shizue Izawa was summoned to another world by &4Demon Lord Leon Cromwell&r. Her body could not adapt to that world's Magicules, leaving her close to death."
		""
		"To keep her alive, Leon forcibly fused the Fire Spirit \"Ifrit\" into her body, making her a \"Fire Majin\". However, Ifrit was not fully under control and could take over her consciousness, transforming her into a destructive fire monster."
		"{image:ablazeaqzlcz:textures/ftb/ifrit_shizu.png width:100 height:100 align:center}"
		"To &bfree Shizue Izawa&r, you must defeat &4the Fire Spirit Ifrit&r."
	]
	quest.3091985C0E95C53F.quest_subtitle: "Fire Majin"
	quest.3091985C0E95C53F.title: "&6【Challenge Line ①】&rAn Otherworlder Who Hates Slimes..."
	quest.30A3566EB22079CA.quest_desc: [
		"&6An important material for crafting golems."
		""
		"With a possession skill, you can use these golems as a new body and inherit the Bone Golem's health. Your race and Magicules are unaffected."
		"&8For example, possessing a 400-HP Bone Golem while you have 20 HP gives you a 400-HP body."
		""
		"When it dies, the Bone Golem returns to your inventory."
	]
	quest.30A3566EB22079CA.quest_subtitle: "Make a puppet"
	quest.30C4FEDFA9A5DB16.quest_desc: [
		"&6Note: Do not use skills while a cutscene is playing, as it may cause the skills in your preset bar to be cleared."
		""
		"Generate on the castle structure in the overworld."
	]
	quest.30C4FEDFA9A5DB16.quest_subtitle: "castle dragon"
	quest.30FB66CFE70278AD.quest_desc: "&6You can find this place using coordinates obtained by trading with the Time Warden"
	quest.30FB66CFE70278AD.quest_subtitle: "The Guardian Vault seals away the dimension's oldest defense core"
