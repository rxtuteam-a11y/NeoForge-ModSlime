	quest.3D857975CC764D30.quest_desc: [
		"If you find a small deepslate house in the Overworld, it might be his home"
		""
		"{image:ablazeaqzlcz:textures/ftb/netherman/believer_house.png width:150 height:100 align:center click_action:none:}"
		""
		"&6Buy a guidebook from the preacher inside, and it will guide you. Of course, you can skip the guide and head straight to the Nether to find the Nether Mansion"
	]
	quest.3D857975CC764D30.quest_subtitle: "Search"
	quest.3D905AACA9BE52EC.quest_desc: "Build a 3×3 base of Pure Magic Blocks, place a Block of Mithril in the center, then right-click it to summon the boss. &6Warning! It must be summoned in the Paths dimension."
