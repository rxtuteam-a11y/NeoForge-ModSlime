	quest.6A183D91CE6AF375.quest_desc: ["Defeating it drops a &5Block of Pure Magisteel&r. Throw one into the center of the Labyrinth Arena to summon the Elemental Colossus again. This can be repeated indefinitely."]
	quest.6A183D91CE6AF375.quest_subtitle: "It's time to take a break"
