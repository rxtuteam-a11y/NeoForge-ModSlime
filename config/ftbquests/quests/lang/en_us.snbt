	quest.1B715F3A51FC08CA.quest_subtitle: "[Choose a route, you can also challenge them all alone]"
	quest.1BA1D9A0C6A07A87.quest_desc: [
		"A vast, naturally lit cave system. This is a massive underground biome containing the ruins of an entire dwarven city. It is a high-risk, high-reward environment where players can find the largest number of mechanical creatures and the most valuable treasures."
		""
		"How do you find it?"
		"You can find a map to it in chests inside abandoned mechanical dwarf ruins on the surface"
	]
	quest.1BA1D9A0C6A07A87.quest_subtitle: "Ruins of a dwarven city"
	quest.1C2128869B7673D7.quest_subtitle: "How can you cook without a stove?"
	quest.1C367AE15A6C4B76.quest_desc: [
		"Grimoires are dropped from various wizard tower chests:"
		""
		"Ruined Wizard Tower"
		"Rotted Wizard Tower"
		"Frozen Wizard Tower"
		"Buried Wizard Tower"
		"Burnt Wizard Tower"
	]
	quest.1C74FBA64D8DB9AB.title: "Ogre King"
	quest.1C7DE5CD874BFD81.quest_desc: ["&6Has a 1% chance to drop from Cave Spiders (Venomous Spiders), Pufferfish, Bees, Witches, and Bogged, and a 2% chance to drop from Aqua Frogs, Army Wasps, Giant Ants, Hell Moths, Hounds (evolved/snake-tailed variants only), Leech Lizards, Phantaspores, Tempest Serpents, Undines, and Landfish.&r Consume 10 while possessing Samael, Lord of Death Poison to lock this Ultimate Skill in the “Lock” interface, preventing its loss upon reincarnation."]
	quest.1C7DE5CD874BFD81.quest_subtitle: "Preserve this skill"
	quest.1CD3F15F43DC7C8F.quest_desc: [
		"Press &6N&r to name a nameable creature. Its HP must be below 25% of its maximum, or it must be affected by Fear caused by the naming player."
		""
		"&d[Tame] (-)&r Uses only enough Magicules to tame the target and does not permanently consume MP."
		""
		"&d[Evolve] (=)&r Evolves the target NPC if applicable, makes it your subordinate, and fully restores its HP. Depending on the strength of the named entity, there is a 5% chance to permanently lose part of your maximum Magicules."
		""
		"&d[Bestow] (+)&r Evolves the target NPC if applicable and multiplies its EP by ten. There is a 10% chance to permanently consume up to 300% of the naming cost. Note that Bestow can grant the target at most 1,000,000 EP."
		""
		"{@pagebreak}"
		"&lQ: How do I make monsters afraid?&r"
		"&lA:&r Use skills such as Coercion or Haki to inflict Fear. Make sure you are ready to name the monster quickly, as Fear may otherwise kill it."
		"(After mastering skills such as Coercion or Haki, adjust their power with Shift + the skill key + the mouse wheel. Lower power deals less damage.)"
	]
