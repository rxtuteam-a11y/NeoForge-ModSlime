	quest.191AA02FB477C725.quest_desc: ["You can only collect this material from a dragon that has not yet been reduced to a skeleton. Right-click the dragon with a Glass Bottle to collect it. Collecting too much turns the dragon into a skeleton, after which you can no longer obtain scales or dragon meat."]
