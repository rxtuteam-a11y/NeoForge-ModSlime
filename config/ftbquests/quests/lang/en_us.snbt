	quest.3C5160A9C279B5A9.quest_desc: [
		"To obtain a Demon Lord Seed, you need &6200,000 EP&r and must be a &5&lMajin / Chaos&r being."
		""
		"&lWhat a Demon Lord Seed allows you to do:&r"
		"&6- Become eligible to awaken as a Demon Lord.&r"
		"&6- Unlock the ability to collect souls.&r"
	]
	quest.3C5160A9C279B5A9.quest_subtitle: "A Demon Lord Seed is an advanced state for a Majin. The souls of living beings are calling to you."
	quest.3C5160A9C279B5A9.title: "&6【Demon Lord Route】&rObtain Demon Lord Seed"
