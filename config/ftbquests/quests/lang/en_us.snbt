	quest.325BE865B5571472.title: "Kill the Sunbird - Umuwuti"
	quest.3295C80D42E1CB08.title: "&6【Advanced】&fObtain the Unique Skill Lust"
	quest.32E1EA9C678DFF9C.quest_desc: ["The center slot holds the output. The bars on either side store the melted materials used for fusion. The section on the far right accepts ores and fuel, just like a furnace."]
	quest.32E1EA9C678DFF9C.quest_subtitle: "Alas, how to refine it?"
	quest.32E1EA9C678DFF9C.title: "&6【Forging Line·Important】&rBurning minerals, forging artifacts"
	quest.32FEF370F61CA35C.quest_desc: ["&8Maybe it's useless for players who have maps, but what if it's an underground dragon's lair?"]
	quest.32FEF370F61CA35C.quest_subtitle: "Looking for dragon props?"
	quest.332803BFA6D1A237.quest_subtitle: "queen from ice castle"
	quest.33334EFC5EC1E3B6.quest_desc: ["It is immune to all conventional attacks and status effects, so normal attacks barely reduce its health. Do not try to leave the arena, and do not fly!"]
	quest.33334EFC5EC1E3B6.quest_subtitle: "What you need to know"
	quest.337C56118E98F19E.title: "Arch Taratect"
	quest.33A31F36D0204245.quest_desc: [
		"It has two phases and uses all of its moves during the first. The second phase strengthens those same abilities."
		"&6Its skills are: Flame Attack Nullification, Heat Nullification, Physical Attack Resistance, Pierce Resistance, and Abnormal Condition Nullification."
	]
	quest.33A31F36D0204245.title: "Crusade against Netherite Monstrosity"
	quest.33AB6B567959623B.quest_desc: ["It spawns on the second floor of the Flame Arena. Defeat it to obtain Dying Embers, then combine four into &lBurning Ashes&r. Right-click the Altar of Fire while holding Burning Ashes to summon the Flame Demon."]
	quest.33AB6B567959623B.quest_subtitle: "Blaze's brother?"
	quest.33AB6B567959623B.title: "Defeat the Ignited Revenant"
	quest.33C7424919F54C10.quest_desc: [
		"&8*Note: Please report bugs in our &5Discord&r&8 or &r&bQQ community&r&8 channels!*&r&r"
		"&#FFBD5BQQ Group 5: 1079552596&r"
