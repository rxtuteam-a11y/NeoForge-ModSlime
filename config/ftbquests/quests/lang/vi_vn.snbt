	quest.6D48812C418A0654.quest_subtitle: "Ở một dạng địa hình nọ có hang động rất nổi bật..."
	quest.6DC42FE3D59ADDB4.quest_desc: "Dường như Rừng Cổ Đại có nguồn linh khí dồi dào?"
