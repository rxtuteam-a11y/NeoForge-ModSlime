	quest.02B3F8BFAE686637.quest_subtitle: "Thế giới tí hon"
	quest.03339785C2F33E9D.title: "【Thiết Kỵ Sĩ】Hoá Thân Khôi Lỗi"
	quest.033E7759B64F002C.quest_desc: [
		"Cách nhận: Dùng Hấp Thu & Phân Giải của Slime, Kẻ Săn Mồi hoặc năng lực có thể đoạt kỹ năng của mục tiêu lên Thằn Lằn Lượn, Thằn Lằn Hút Máu hoặc Bạo Phong Đại Xà."
		""
		"&l[Bị động - Bật/Tắt]:&r Khi bật, thực thể được đánh dấu là \"máu nóng\" trong bán kính 20 khối sẽ có viền đỏ. Thực thể máu lạnh không hiển thị, còn nguồn lạnh như Người Tuyết sẽ có viền xanh ngọc. Không hoạt động ở Nether."
	]
	quest.033E7759B64F002C.quest_subtitle: "Phát hiện kẻ địch tại điểm đánh dấu"
	quest.033E7759B64F002C.title: "&6【Mẹo】&rSở hữu 【Cảm Tri Nhiệt Nguyên】"
	quest.033ECFF9D28A7F31.quest_subtitle: "Cho rồng đực và rồng cái ăn riêng để chúng sinh sản"
