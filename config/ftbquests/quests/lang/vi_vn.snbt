	quest.603A9A2A25A20537.quest_desc: "Hiện xuất hiện ngoài tự nhiên trong Linh Giới. Bạn có thể tình cờ gặp khi khám phá."
	quest.603A9A2A25A20537.quest_subtitle: "Boss tồn tại trong Linh Giới"
	quest.609C124E1EAD39BA.quest_desc: "Có thể khai thác rồi phân giải thành Tinh Thể Thời Gian"
	quest.609C124E1EAD39BA.title: "Đây là báu vật"
	quest.60C0471AB7032E82.quest_desc: [
		"1. Thông thạo 【Raphael, Trí Tuệ Chi Vương】 và trở thành Chân Ma Vương hoặc Chân Anh Hùng."
		"2. Dùng chế độ “Hợp Nhất” của Raphael hấp thu 5 Hạch Charybdis."
		"3. Dùng chế độ “Tinh Luyện” của Raphael tạo tổng cộng 64 vật phẩm."
		"4. Khi giao chiến với sinh vật không phải đồng minh, máu phải thấp hơn 25%."
	]
	quest.60C0471AB7032E82.quest_subtitle: "Điều kiện ↓"
	quest.60C0471AB7032E82.title: "&6【Siêu Nâng Cao】&fKỹ năng Tối thượng: Thần Trí Hạch Ciel"
	quest.60CAD3547CAF1AE2.quest_desc: "&6Có tỉ lệ 80% rơi từ Hinata. &rKhi sở hữu Uriel, tiêu thụ 10 vật phẩm để khoá Kỹ năng Tối thượng trong màn hình \"Khoá\", giúp giữ lại khi chuyển sinh."
	quest.60E49F02ABCAEB42.quest_desc: ["Có lỗ trên mặt đất dẫn vào trong. Nội thất xếp theo hình bàn cờ caro; đi vào giữa để tìm phòng Boss."]
	quest.60E49F02ABCAEB42.quest_subtitle: "Nhà máy chôn dưới lòng đất"
	quest.60E49F02ABCAEB42.title: "Khám phá Xưởng Đúc Khôi Lỗi"
