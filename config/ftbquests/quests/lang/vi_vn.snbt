	quest.5400019E1A822A40.quest_desc: "Có tỉ lệ 50% rơi khi người chơi tiêu diệt Thổ Tinh Linh."
	quest.5400019E1A822A40.quest_subtitle: "Hồi Đấu Khí nhanh chóng"
