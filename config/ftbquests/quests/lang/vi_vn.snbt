	quest.6CA53A7C9D542C77.title: "Không Gian Tinh Linh · Thượng Cấp"
	quest.6CAEB3F499FD5877.quest_desc: ["&6Khi sở hữu Phong Nhương Chi Vương, thu hoạch cây trồng có 1% cơ hội nhận được.&r"]
	quest.6D0CA0984266A8E2.quest_desc: ["Tỉ giá tiền xu là 1:100. Có thể dùng các loại xu giao dịch với người lùn hoặc Thằn Lằn Nhân để lấy nhiều món hay ho, như bản thiết kế, sách phép hay cuộn ma pháp?"]
