	quest.70918DAFF1515131.quest_desc: ["&8Có thể tìm thấy nhiều ma pháp và ma cụ kỳ lạ bên trong."]
	quest.70918DAFF1515131.quest_subtitle: "Ngọn tháp ở vùng đất hiểm"
	quest.70B7EC3378B6237D.quest_subtitle: "Công thủ toàn diện"
	quest.70E1F2210C8BFDCD.quest_desc: [
		"Dịch vụ máy chủ cho hơn 110 game với BisectOne"
		"Tự động cài sẵn hơn 2.300 modpack Minecraft"
		"Hỗ trợ xử lý lỗi máy chủ và mod 24/7/365"
