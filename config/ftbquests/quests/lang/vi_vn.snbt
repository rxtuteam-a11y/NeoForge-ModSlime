	quest.4EDB9D7AEC78646C.quest_desc: [
		"Cách nhận: Thông thạo Vạn Năng Cảm Tri + đạt 10.000 Ma Tố tối đa"
		""
		"&l[Chủ động - Nhấn]:&r Phóng làn quét Ma Khoáng lan rộng, làm nổi bật Quặng Ma Khoáng và Quặng Ma Khoáng Đá Sâu xuyên khối. Trước thông thạo: bán kính 12 khối, kéo dài 8 giây, tốn 2.500 Ma Tố, hồi 12 giây. Sau thông thạo: bán kính 20 khối, kéo dài 16 giây, tốn 1.500 Ma Tố, hồi 6 giây. Mỗi lần kích hoạt thành công nhận 1 điểm thông thạo."
	]
	quest.4EDB9D7AEC78646C.quest_subtitle: "Muốn đào Ma Khoáng nhanh hơn?"
