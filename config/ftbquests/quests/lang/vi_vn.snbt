	quest.263A8208AA5CCDA6.quest_desc: [
		"&#FFED54Liên kết:&r"
		"[{\"text\": \"Cách hoạt động của Cổ Vật\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"4DB740093C0BA804\"}}]"
		""
		"Hiệu ứng mặc định"
		"&5Hiệu ứng 1: Tiết Kiệm Ma Tố"
		"Giảm 10% MP/Ma Tố tiêu hao khi thi triển ma pháp."
		"Hiệu ứng có tác dụng khi trang bị cổ vật và đã mở khoá hiệu ứng."
		""
		"Thưởng tinh luyện"
		"Mỗi lần tinh luyện giảm thêm 1% MP/Ma Tố tiêu hao khi thi triển ma pháp."
		"Tối đa: Ở mức tinh luyện +10, Tiết Kiệm Ma Tố giảm 20% chi phí MP/Ma Tố của ma pháp."
	]
