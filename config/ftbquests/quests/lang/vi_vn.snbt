	quest.2407E305A960BE43.title: "&6【Nâng Cao】&fKỹ năng Tối thượng Asmoday"
	quest.24A42438DA227224.quest_desc: [
		"&6Các phím thường dùng của Tensura:"
		"Bảng cá nhân: phím B&b(Gán kỹ năng, xem trạng thái)"
		"Năng lực chủng tộc: phím R&b(Một số chủng tộc có năng lực riêng)"
		"Thi triển kỹ năng: phím Z, X, C; ALT + phím tương ứng để đổi chế độ"
		"&6Lưu ý: Một số kỹ năng dùng Shift + phím tương ứng để đổi chế độ phụ"
		""
		"Né tránh/Xuống thú cưỡi: phím V"
		"Ban danh sinh vật: phím N&b(Một số sinh vật có thể đặt tên, cần đủ EP)"
		""
		"&6Các phím thường dùng khác:"
		"Mở ba lô: phím H&b(Ba Lô Tinh Xảo)"
		"Mở bản đồ lớn: phím M"
		"Đốn cây liên hoàn: Shift + ngồi xuống + chuột trái để chặt"
	]
	quest.24A42438DA227224.quest_subtitle: "【Nội dung cần xem】"
	quest.24A44C95A35D658D.quest_desc: [
