	quest.73C78DF62012F4B2.quest_desc: [
		"Giữ chuột phải để phóng móc, chuột trái vươn \"xúc tu bí ẩn\" tấn công sinh vật."
		"&6EP mặc định: 0"
		"&6Tiêu diệt sinh vật có thể tăng EP, nhưng vũ khí không thể tiến hoá."
	]
	quest.73C78DF62012F4B2.quest_subtitle: "Móc leo núi"
	quest.7423FDFD1AC6979D.quest_desc: [
