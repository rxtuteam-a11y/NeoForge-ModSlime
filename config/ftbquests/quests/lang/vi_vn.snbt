	quest.23EA140A74800390.quest_desc: [
		"Bạn cần hồi máu khi chiến đấu với Boss trong lúc còn dưới 25% máu tối đa, và Boss &lphải đáp ứng:"
		"- Có ít nhất 400k EP"
