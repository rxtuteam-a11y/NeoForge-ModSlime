	quest.01C15539C13DCD2F.quest_desc: ["&6Rơi từ Quỷ Lửa với tỉ lệ 1%.&r Khi sở hữu Velgrynd, tiêu thụ 10 vật phẩm này để có thể khoá Kỹ năng Tối thượng trong menu “Khoá”, giúp giữ lại kỹ năng khi chuyển sinh."]
