	quest.27B051980987A3F2.quest_subtitle: "Thi triển ma pháp nhanh hơn"
	quest.27B051980987A3F2.title: "&6【Mẹo Tân Thủ】&rKỹ năng thiết yếu [Gia Tốc Tư Duy]"
	quest.27E25F9CD0680399.quest_desc: "Có tỉ lệ rất nhỏ nhận được khi tiêu diệt Quỷ Lửa hoặc Ifrit"
	quest.27E25F9CD0680399.quest_subtitle: "Cách thu thập"
	quest.28B912AFF70B40C7.quest_desc: ["Có thể lấy từ cốt long ngoài tự nhiên hoặc rồng bị hạ sát."]
