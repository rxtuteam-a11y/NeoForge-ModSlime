	quest.129638DFCD29D823.quest_subtitle: "[Nhấp để nộp nhiệm vụ sau khi nhận được tinh linh tương ứng]"
	quest.129638DFCD29D823.title: "Phong Tinh Linh · Thượng Cấp"
	quest.129C3092F055B640.title: "Quỷ Quân"
	quest.12B1D45C91AFEAEB.quest_desc: ["Hồi 1000 MP sau khi uống"]
	quest.12B1D45C91AFEAEB.quest_subtitle: "Dược thông thường, chưa đun sôi"
	quest.12E7EFE9B3A1B5A7.quest_desc: [
		"Bạn có biết? Trang bị chế từ da thấm Ma Tố &6(Hạng C)&r không hề kém giáp sắt, thậm chí còn mạnh hơn! Chúng còn có thể nâng cấp nữa!"
		"&cHạng C (5k EP) -> Hạng B (8k EP) -> Hạng A (80k EP) -> Đặc Hạng A&r"
		"&8(Không thể xem còn bao nhiêu lần nâng cấp hoặc EP tích luỹ. EP hiển thị trên trang bị chỉ dùng làm độ bền)&r"
	]
	quest.12E7EFE9B3A1B5A7.quest_subtitle: "Da thấm Ma Tố"
	quest.12E7EFE9B3A1B5A7.title: "&6【Nhiệm Vụ Phụ · Phúc Lợi】&rBộ trang bị Da Ma Vật?"
	quest.131BE03E626D5661.quest_desc: ["Công trình này chỉ xuất hiện ở Nether, có thể tìm bằng Con Mắt Hoả Diễm"]
	quest.131BE03E626D5661.quest_subtitle: "Công trình xây trong Nether"
	quest.131BE03E626D5661.title: "Đến Đấu Trường Hoả Diễm"
	quest.138625D83CAE9E7C.quest_subtitle: "[Nhấp để nộp nhiệm vụ sau khi nhận được tinh linh tương ứng]"
	quest.138625D83CAE9E7C.title: "Hoả Tinh Linh · Thượng Cấp"
	quest.139C40496643C9CC.quest_desc: ["Thông thạo 【Nhà Toán Học】 và 【Kẻ Soán Đoạt】, trở thành Chân Anh Hùng hoặc Chân Ma Vương, đồng thời có ít nhất 500.000 Ma Tố."]
	quest.139C40496643C9CC.quest_subtitle: "Điều kiện ↓"
	quest.139C40496643C9CC.title: "&6【Nâng Cao】&fKỹ năng Tối thượng: Fortuna, Vận Mệnh Chi Vương"
	quest.14AC04DF8CDFD067.quest_desc: [
		"&6Cần 5.000.000 EP để bước qua cổng trong nhà thờ và đến chiều không gian này."
		""
		"Có thể tìm thấy Feldway tại đây. Hắn là một trong \"Thất Đại Thiên Sứ Thuỷ Tổ\" do Tinh Vương Long Veldanava tạo ra, là thiên sứ ra đời đầu tiên và sở hữu sức mạnh vượt trội."
	]
	quest.14AC04DF8CDFD067.quest_subtitle: "Nhà thờ bỏ hoang ở đồng bằng"
	quest.14CD486EE27C60B3.quest_subtitle: "Đặt Bình Ma Thuỷ vào lò để \"đun sôi\""
	quest.14CD486EE27C60B3.title: "Bình Ma Thuỷ sau khi đun"
	quest.14DF20843C746694.quest_subtitle: "Ma Vương trên ngọn tháp"
	quest.15009A4C69307199.quest_desc: "&6Có tỉ lệ 80% rơi từ Rimuru. &rKhi sở hữu Bạo Thực Chi Vương, tiêu thụ 10 vật phẩm để khoá Kỹ năng Tối thượng trong màn hình \"Khoá\", giúp giữ lại khi chuyển sinh."
	quest.15009A4C69307199.quest_subtitle: "Bảo lưu kỹ năng này"
	quest.15B40702B126BC7E.quest_desc: [
		"Đặt &l【Hạch Charybdis】&r tại khu vực sinh ma vật rồi tiêu diệt chúng để cung cấp EP cho hạch."
		"Dùng kỹ năng kiểm tra hoặc đào xuống để xem EP. Khi đạt 100.000 EP, hạch bắt đầu phát sáng và phát ra âm thanh kỳ lạ."
		"Nhấp chuột phải để ấp nở &l【Charybdis】&r"
	]
	quest.15B40702B126BC7E.quest_subtitle: "Triệu hồi ư?"
	quest.15B40702B126BC7E.title: "Tìm và thảo phạt Bạo Phong Đại Yêu - Charybdis Vòng Xoáy"
	quest.1600000000000001.quest_desc: [
		"1. Chiếm hữu Người Sói để trở thành Thiên Cẩu"
		"2. Dùng Tinh Hoa Bí Ẩn để trở thành Yêu Ma"
		"3. Dùng Tinh Hoa Ác Ma để trở thành Đoạ Thiên Sứ"
		"4. Đi theo lộ trình tiến hoá Thiên Sứ thông thường"
	]
	quest.1600000000000001.quest_subtitle: "Lộ trình tiến hoá"
	quest.166F39FFE1C98A63.quest_desc: [
		"Cho phép khoá một kỹ năng được hỗ trợ. Sau khi khoá, người chơi vẫn giữ được kỹ năng dù đặt lại nhân vật."
		"{image:ablazeaqzlcz:textures/ftb/lock.png width:100 height:122 align:center}"
		""
		"Số ô khoá phụ thuộc cấp linh hồn."
		"Cấp 1–2: 1 ô"
		"Cấp 3–5: 2 ô"
		"Trên cấp 6: 3 ô"
		""
		"Mở khoá tiêu tốn tài nguyên:"
		"10 triệu EP"
		"3 cấp linh hồn"
		"Ma Tố bổ sung"
	]
	quest.166F39FFE1C98A63.quest_subtitle: "Trang khoá kỹ năng dùng để làm gì?"
	quest.16E0F71FC9927156.quest_desc: ["Tay trái đại bác, tay phải cưa máy, mắt còn bắn được laser."]
	quest.16E0F71FC9927156.quest_subtitle: "Chúng chưa hề rỉ sét"
	quest.16E0F71FC9927156.title: "Người canh giữ lòng đất"
	quest.178630352DAC45B8.quest_desc: ["&8Sinh vật rất thường gặp ở đồng bằng hoặc tổ kiến"]
	quest.178630352DAC45B8.quest_subtitle: "To gấp mấy lần con người"
	quest.178630352DAC45B8.title: "Sao lại có kiến khổng lồ thế này?"
	quest.17D5656DDF929E02.quest_desc: [
		"Thông thạo [Bạo Thực] và [Vô Tâm Giả]. Chủng tộc phải là Mầm Mống Anh Hùng / Chân Anh Hùng hoặc Hạt Giống Ma Vương / Chân Ma Vương."
		""
		"Trong chế độ nhiều người chơi, chỉ một người được sở hữu kỹ năng này. Để bỏ giới hạn, dùng /gamerule beelzebubTrulyUnique false"
	]
	quest.17D5656DDF929E02.quest_subtitle: "Điều kiện sở hữu↓"
	quest.17D5656DDF929E02.title: "&6[Nâng Cao]&fKỹ năng Tối thượng Beelzebub"
	quest.182068714BF79ADB.quest_subtitle: "Chọn một trong hai kỹ năng cùng với Chi Phối Phong"
	quest.182068714BF79ADB.title: "&6[Nâng Cao]&fSở hữu và thông thạo Thao Túng Phong"
	quest.1828789F09A9F162.title: "{translate:\"task.F6A7B8C9D0E12355.title\"}"
	quest.187252C941FBC59B.quest_desc: [
		"Chế tạo Sợi Rực Rỡ rồi cầm nó nhấp chuột phải vào lá cây. Chờ khoảng một ngày trong game để chúng thành Lá Vàng, sau đó thu hoạch."
		""
		"&6Nên thu ít nhất 20 Lá Vàng trước, vì các nghi thức, tế đàn và tín vật về sau cần khá nhiều.&r"
	]
	quest.187252C941FBC59B.quest_subtitle: "Khởi đầu"
	quest.187252C941FBC59B.title: "Thời đại linh khí hồi sinh"
	quest.18B0E4E9EBA923B2.title: "{translate:\"task.CC3D4E5F6A7B8902.title\"}"
	quest.19098B587950C0D2.quest_desc: [
		"Thú cưỡi của bạn được tăng tốc độ"
		"&6&lPhi Nước Đại [Mở khoá Bách Khoa]"
		"{image:ablazeaqzlcz:textures/ftb/curios/cowboy_hat.png width:50 height:80 align:left}"
	]
	quest.19098B587950C0D2.quest_subtitle: "Cao bồi miền Tây"
	quest.190D1347F76969DD.quest_subtitle: "Công trình trên đảo ngoài của The End"
	quest.190D1347F76969DD.title: "Tìm đấu trường \"khắc nghiệt\""
	quest.191AA02FB477C725.quest_desc: ["Chỉ có thể lấy nguyên liệu này từ rồng chưa biến thành bộ xương."]
	quest.191AA02FB477C725.quest_subtitle: "Thu thập từ xác rồng"
	quest.191AA02FB477C725.title: "Thu thập máu rồng"
	quest.19269D0C42C44F99.quest_desc: ["Công trình của nền văn minh cổ chôn dưới lòng đất, có thể tìm bằng Con Mắt Cơ Giới"]
	quest.19269D0C42C44F99.quest_subtitle: "Sức mạnh của đấng sáng tạo nào đây?"
	quest.19269D0C42C44F99.title: "Đến Nhà Máy Cổ Đại"
	quest.19F38BBF546A9466.quest_desc: "Có cơ hội nhận khi đánh bại Thuỷ Tinh Linh hoặc khai thác ở quần xã Gai Băng"
	quest.19F38BBF546A9466.quest_subtitle: "Cách thu thập"
	quest.1A2B3C4D5E6F7890.title: "{translate:\"task.1A2B3C4D5E6F7891.title\"}"
	quest.1A39147D2FC7AF3C.quest_subtitle: "Bốc hơi nào"
	quest.1A3F6434B2919A16.quest_desc: ["&6Có tỉ lệ 1% rơi khi tiêu diệt sinh vật mang hiệu ứng Cuồng Bạo. &rTiêu thụ 10 vật phẩm để mở khả năng khoá Phẫn Nộ Chi Vương trong màn hình “Khoá”."]
	quest.1AA35C0479B67340.quest_subtitle: "Cách tiến hoá tốt hơn"
	quest.1ADD951F05FFD421.quest_subtitle: "Trực tiếp đánh bại!"
	quest.1ADD951F05FFD421.title: "Thảo phạt Nhà Điêu Khắc - Bậc Thầy Cánh Tay"
	quest.1AECBCFE5C2CD2C7.quest_desc: [
		"Tiến hoá bằng chế độ “Hợp Nhất” của Raphael, Trí Tuệ Chi Vương, đồng thời đáp ứng mọi điều kiện sau:"
		"- Trở thành Chân Ma Vương."
		"- Thông thạo Raphael, Trí Tuệ Chi Vương."
		"- Thông thạo Uriel, Thệ Ước Chi Vương."
		"- Thông thạo Beelzebuth, Bạo Thực Chi Vương."
		"- Thông thạo ít nhất 20 kỹ năng."
		"- EP tối đa đạt 2.000.000. Không tiêu hao EP."
		"- Có ít nhất 1.000.000 Ma Tố. Tiến hoá thành công sẽ tiêu hao 1.000.000 Ma Tố."
		""
		"Trong chế độ nhiều người chơi, chỉ một người được sở hữu kỹ năng này. Để bỏ giới hạn, dùng /gamerule shubNiggurathTrulyUnique false"
	]
	quest.1AECBCFE5C2CD2C7.quest_subtitle: "Điều kiện sở hữu ↓"
	quest.1AECBCFE5C2CD2C7.title: "&6【Nâng Cao】&fKỹ năng Tối thượng: Shub-Niggurath, Phong Nhương Chi Vương"
	quest.1AF9B2AEF4CA630F.quest_desc: [
		"Cầm Lễ Vật Vực Thẳm nhấp chuột phải vào Tế Đàn Vực Thẳm ở giữa để triệu hồi."
		"&6Nó có hai giai đoạn, sở hữu: Vô Hiệu Công Kích Thuỷ, Vô Hiệu Lạnh, Kháng Công Kích Vật Lý, Kháng Đâm Xuyên, Kháng Độc, Kháng Điện Giật và Kháng Sóng Nhiệt."
	]
	quest.1AF9B2AEF4CA630F.quest_subtitle: "Cự thú biển sâu"
	quest.1AF9B2AEF4CA630F.title: "Thảo phạt Leviathan"
	quest.1B277EAB185E607D.title: "Taratect Độc Hạ Cấp"
	quest.1B715F3A51FC08CA.quest_subtitle: "[Chọn một tuyến, chơi đơn cũng có thể khiêu chiến tất cả]"
	quest.1BA1D9A0C6A07A87.quest_desc: [
		"Hệ thống hang động rộng lớn với ánh sáng tự nhiên. Quần xã ngầm khổng lồ này chứa tàn tích cả một thành phố người lùn. Nơi đây nguy hiểm nhưng phần thưởng rất lớn, có nhiều sinh vật cơ giới và kho báu giá trị nhất."
		""
		"Tìm bằng cách nào?"
		"Có thể tìm bản đồ dẫn đến đây trong rương ở tàn tích người lùn cơ giới bỏ hoang trên mặt đất"
	]
	quest.1BA1D9A0C6A07A87.quest_subtitle: "Tàn tích thành phố người lùn"
	quest.1C2128869B7673D7.quest_subtitle: "Không có bếp thì nấu thế nào?"
	quest.1C367AE15A6C4B76.quest_desc: [
		"Ma Đạo Thư có thể tìm trong rương của các tháp pháp sư:"
		""
		"Tháp Pháp Sư Đổ Nát"
		"Tháp Pháp Sư Mục Nát"
		"Tháp Pháp Sư Băng Giá"
		"Tháp Pháp Sư Chôn Vùi"
		"Tháp Pháp Sư Cháy Rụi"
	]
	quest.1C74FBA64D8DB9AB.title: "Quỷ Vương Ăn Thịt Người"
	quest.1CD3F15F43DC7C8F.quest_desc: [
		"Nhấn &6N&r để ban danh cho sinh vật có thể đặt tên. Mục tiêu phải còn dưới 25% máu tối đa hoặc đang chịu hiệu ứng Sợ Hãi do người ban danh gây ra."
		""
		"&d[Thuần Phục] (-)&rChỉ tiêu hao lượng ma lực cần để thuần phục mục tiêu, không làm giảm MP vĩnh viễn."
		""
		"&d[Tiến Hoá] (=)&rNếu đáp ứng điều kiện, NPC mục tiêu sẽ tiến hoá."
		""
		"&d[Ban Ân] (+)&rNếu đáp ứng điều kiện, NPC sẽ tiến hoá, EP tăng gấp mười; có 10% xác suất tiêu hao vĩnh viễn lượng Ma Tố lên đến 300% chi phí ban danh."
		""
		"{@pagebreak}"
		"&lHỏi: Làm sao khiến ma vật sợ hãi?&r"
		"&lĐáp:&rDùng Uy Áp, Bá Khí hoặc năng lực tương tự gây Sợ Hãi, đáp ứng điều kiện ban danh nhanh rồi đặt tên cho chúng."
		"(Khi thông thạo Uy Áp, Bá Khí và các kỹ năng tương tự, có thể chỉnh uy lực bằng Shift + phím kỹ năng + chuột. Uy lực càng thấp thì sát thương càng nhỏ.)"
	]
	quest.1CD3F15F43DC7C8F.quest_subtitle: "Ban danh như thế nào?"
	quest.1CF63C044EAFA8D7.quest_subtitle: "Sinh vật ở Rừng Sồi Sẫm và Rừng Nhợt Nhạt"
	quest.1CF63C044EAFA8D7.title: "Bướm Đêm Khổng Lồ"
	quest.1D217C6641299B70.quest_subtitle: "Có thể tìm trong Tháp Hoàng Gia Người Lùn"
	quest.1D217C6641299B70.title: "Cờ Vương Quốc Người Lùn"
	quest.1D870390E22D0E28.quest_subtitle: "Ta muốn uống canh"
	quest.1DE8784B7276EDA8.title: "&6【Nhiệm Vụ Phụ】&rMạnh hơn nữa!"
	quest.1DF55B2C88B9B888.quest_desc: [
		"Uống dược nhanh hơn"
		"&6&lUống Nhanh【Mở khoá Bách Khoa】"
		"{image:ablazeaqzlcz:textures/ftb/curios/plastic_drinking_hat.png width:50 height:80 align:left}"
	]
	quest.1DF55B2C88B9B888.quest_subtitle: "Uống cạn một hơi"
	quest.1E2728F6C84FFB35.quest_desc: ["Có thể tìm loại đá này trên mặt đất, quanh các suối nước nóng."]
	quest.1E2728F6C84FFB35.quest_subtitle: "Quặng nóng bỏng"
	quest.1E2728F6C84FFB35.title: "Quặng bên suối nước nóng"
	quest.1E58DB775CD0CE1E.quest_subtitle: "【Thông Thạo】"
	quest.1E58DB775CD0CE1E.title: "&6【Nâng Cao】&fSở hữu Kỹ năng Độc nhất Thích Nghi"
	quest.1E7A25799F815ABA.quest_desc: [
		"Sau khi nhận nghề Tiều Phu, người lùn sẽ đi đốn cây và tự trồng lại. Xong việc, họ đến rương gần nhất để cất gỗ."
		"Vì vậy, hãy rào một khu trồng cây, đặt nhiều trạm làm việc đốn gỗ cùng các rương bên trong để tạo trang trại gỗ tự động hoàn toàn."
		""
		"&6Lưu ý: npcWorking mặc định tắt. Hãy bật bằng /gamerule npcWorking true"
		"&4Nếu bật quy tắc này khi có quá nhiều người lùn, TPS có thể giảm xuống 10!"
	]
	quest.1E7A25799F815ABA.quest_subtitle: "Bãi gỗ tự động hoàn toàn"
	quest.1E7A25799F815ABA.title: "Sao lại trộm gỗ của tiều phu chứ!"
	quest.1EDD37632534A093.title: "Arachne"
	quest.1EEA7724FA3BB72C.quest_desc: [
		"Tiêu diệt sinh vật để nhận nhiều chiến lợi phẩm hơn."
		"&6&lChiến Lợi Phẩm Dồi Dào【Mở khoá Bách Khoa】"
		"{image:ablazeaqzlcz:textures/ftb/curios/superstitious_hat.png width:50 height:80 align:left}"
	]
	quest.1EEA7724FA3BB72C.quest_subtitle: "Đoạt lấy"
	quest.1F6166FE5D1FA206.quest_subtitle: "Toà thành bị tà linh tàn phá"
	quest.1F894D1554FABD87.quest_desc: [
		"Xuống đáy biển nhanh hơn?"
		"&6&lChìm Như Neo [Mở khoá Bách Khoa]"
