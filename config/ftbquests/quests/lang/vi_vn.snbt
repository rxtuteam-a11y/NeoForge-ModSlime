	quest.5474A5F7A78E8140.title: "{translate:\"task.D4E5F6A7B8C90133.title\"}"
	quest.54A4F82AB4B24F5F.title: "&6【Nâng Cao】&fSở hữu Kỹ năng Độc nhất Du Hành Thời Gian"
	quest.54A65C21C2F61A39.quest_desc: ["&6Rơi từ Quỷ Lửa với tỉ lệ 1%.&r Khi sở hữu Velgrynd, tiêu thụ 10 vật phẩm này để có thể khoá Kỹ năng Tối thượng trong menu “Khoá”, giúp giữ lại kỹ năng khi chuyển sinh."]
	quest.5516DAB3B483E0B7.quest_desc: ["&8Có thể tìm thấy nhiều ma pháp và ma cụ kỳ lạ bên trong."]
	quest.5516DAB3B483E0B7.quest_subtitle: "Ngọn tháp ở Đồng Bằng Chướng Khí"
	quest.551FE8D1E67DD299.title: "&6【Tinh Linh Ma Khoáng】&5Khai thác Ma Tinh Thạch"
	quest.553FAC18CEC86043.quest_subtitle: "[Nhấp để nộp nhiệm vụ sau khi nhận được tinh linh tương ứng]"
	quest.553FAC18CEC86043.title: "Thuỷ Tinh Linh · Trung Cấp"
	quest.55465CA3AEA7E0F1.quest_desc: [
		"&lGeld&r"
		"Vốn là hoàng tử tộc Orc, để cứu đồng bào bên bờ diệt vong vì nạn đói, hắn chấp nhận cám dỗ của Ma Vương Hề, nuốt Hạt Giống Ma Vương rồi tiến hoá thành \"Orc Chúa\"."
		""
		"Khi thôn phệ đủ sinh vật và đạt 210.000 EP, hắn sẽ tiến hoá thành &l&4“Orc Tai Hoạ”&r&r"
	]
	quest.55465CA3AEA7E0F1.quest_subtitle: "Ăn và giết, tất cả chỉ để thoả cơn đói"
	quest.55F3BC7CA2C07E54.quest_desc: "Đánh bại Feldway để nhận."
	quest.55F3BC7CA2C07E54.quest_subtitle: "Điều kiện↓"
	quest.55F3BC7CA2C07E54.title: "&6【Nâng Cao】&fKỹ năng Tối thượng Naberius"
	quest.55FEB0F5F67B25C0.quest_desc: [
		"Nhà Điêu Khắc - Bậc Thầy Cánh Tay ngồi yên giữa tu viện, chờ người chơi"
		"{image:ablazeaqzlcz:textures/ftb/adventure/sculptor_home.png width:170 height:100 align:center}"
		"Này! Nghe ta đã, đừng vội giết Nhà Điêu Khắc. Hãy tiêu diệt Cư Dân Bùn lấy Trượng Bùn, rồi nhấp chuột phải đưa cho ông để nhận thử thách. Vượt qua, ông sẽ trao Găng Tay Địa Liệt."
	]
	quest.55FEB0F5F67B25C0.quest_subtitle: "Tu viện trên núi"
	quest.5607EC73F64E7547.quest_subtitle: "Nâng cấp từ Bùa Thì Thầm"
	quest.56143EC527358E72.quest_desc: ["Tiêu diệt Tư Tế Nguyên Linh hoặc Thuật Sĩ Nguyên Linh để lấy Dao Găm Nghi Lễ, tiêu diệt Golem San Hô để lấy Mảnh San Hô Kết Tinh. Cuối cùng dùng bản đồ trong xác tàu tìm kho báu dưới cát (Trái Tim Biển Cả) để đủ nguyên liệu đặc biệt."]
	quest.56143EC527358E72.quest_subtitle: "\"Trái tim\" của Leviathan"
	quest.5614F7D4AC61BBB1.quest_subtitle: "Xào nấu cần thêm mỡ"
	quest.5614F7D4AC61BBB1.title: "Dùng dao bếp giết lợn để lấy mỡ"
	quest.562256A0E06D846D.quest_subtitle: "Mật thất chôn dưới lòng đất"
	quest.562807A2687B3DEF.quest_desc: [
		"Có thể tìm trong nhà thờ ở Thế Giới Thường (Dân Làng Vẽ Bản Đồ cấp Đại Sư có cơ hội bán bản đồ), hoặc xuất hiện ngoài tự nhiên."
		""
		"&8Thù địch với ma vật, trung lập với chủng tộc phi ma vật&r"
		"Nếu chưa có kỹ năng hoặc ma pháp mạnh, đừng thử khiêu chiến cô ấy!"
		"{image:ablazeaqzlcz:textures/ftb/hinata_sakaguchi.png width:60 height:60 align:center}"
		"&lGiải thích các giai đoạn Boss:&r"
		""
		"&lGiai đoạn một&r"
		"&6-Triệu hồi 5 tinh linh thượng cấp và bước vào \"chế độ Kết Giới Đoạn Tuyệt\"."
		"&6-Khi các tinh linh thượng cấp bị đánh bại, Hinata chuyển sang giai đoạn hai.&r&r"
		""
		"&lGiai đoạn hai&r"
		"&6-Ở giai đoạn này, Hinata chỉ dùng kỹ năng bị động và tấn công bằng \"Thất Thải Chung Yên Thứ\", đồng thời dịch chuyển một ít."
		"&6-Chuyển sang giai đoạn ba khi máu dưới 75%.&r"
		""
		"&lGiai đoạn ba&r"
		"&5Hinata tiếp tục dùng kiếm kỹ và đồng thời thi triển: Hắc Viêm Ngục, Bão Tuyết, Địa Lao và Thiên Không Trảm&r"
		"&6-Khi máu dưới 50%, bắt đầu thi triển \"Băng Hoại Nguyên Tử\":"
		" &6-Trong khi niệm, tốc độ di chuyển của mục tiêu bị giảm."
		" &6-Cần gây đủ sát thương lên cô ấy để ngắt chiêu."
		" &6-Nếu \"Băng Hoại Nguyên Tử\" trúng mục tiêu, mục tiêu chết ngay lập tức."
		" &6-Khi máu còn 25%, chuyển sang giai đoạn bốn."
		""
		"&lGiai đoạn bốn&r"
		"&6-Khi vào giai đoạn này, Hinata hồi về 50% máu và lấy đó làm máu tối đa mới (thanh vàng)."
		"&6-Tốc độ hồi phục bị động tăng lên:"
		"&6-Hồi 10 máu + 50 sinh lực linh hồn mỗi giây"
		"&6-Hinata dùng toàn bộ kỹ năng các giai đoạn trước và trang bị thêm: (Thánh Linh Vũ Trang) (Nguyệt Quang Tế Kiếm)"
		"&6-Hiệu ứng Dung Linh Trảm: Bỏ qua giáp, kháng tính và giảm phòng ngự khi đánh trúng, trực tiếp gây 3000 sát thương."
	]
	quest.562807A2687B3DEF.quest_subtitle: "Sakaguchi Hinata"
	quest.562807A2687B3DEF.title: "\"Chúc may mắn\""
	quest.5631F6ECD23395D2.quest_desc: [
		"Boss có cơ hội xuất hiện ngoài tự nhiên."
		""
		"&8Thù địch với ma vật và chủng tộc phi nhân, trung lập với Nhân Tộc&r"
		"&8Thù địch với sinh vật có hơn 10.000 EP&r"
		"Nếu chưa có kỹ năng hoặc ma pháp mạnh, đừng thử khiêu chiến hắn!"
		""
		"&lGiải thích các giai đoạn Boss:&r"
		""
		"&lGiai đoạn một&r"
		"&6-Dùng đòn Đấu Khí cận chiến và tầm xa."
		"&6-Có 15% cơ hội né và có thể dịch chuyển đến mục tiêu khi bị tấn công."
		"&6-Kỹ năng: Đấu Khí Trảm, Tượng Bộ Đấu Khí Đạn."
		"&6-Hồi 12 máu + 60 sinh lực linh hồn mỗi giây."
		"&6-Chuyển sang giai đoạn hai khi máu dưới 50%.&r"
		""
		"&lGiai đoạn hai (dạng Thú Vương)&r"
		"&6-Khi vào giai đoạn này, Carrion hồi đầy máu, Ma Tố, Đấu Khí và xoá mọi hiệu ứng bất lợi."
		"&6-Nhận khả năng bay."
		"&6-Xác suất né tăng lên 30%."
		"&6-Tăng 20 điểm giáp, 20 sức tấn công và 0,2 Kháng Đẩy Lùi."
		"&6-Tốc độ hồi phục bị động giảm còn 4 máu + 20 sinh lực linh hồn mỗi giây."
		"&6-Carrion dùng toàn bộ kỹ năng giai đoạn một và có khả năng cơ động mạnh hơn."
	]
	quest.5631F6ECD23395D2.quest_subtitle: "Nghe nói ngươi ngông lắm"
	quest.5631F6ECD23395D2.title: "Chiến binh cận chiến hùng mạnh"
	quest.56413501A9E9D8FC.quest_desc: [
		"&6Người chơi khởi đầu với 0 điểm Danh Vọng Người Lùn (gọi tắt là DR)."
		""
		"1. Tấn công người lùn khi có người lùn chưa thuần phục khác ở gần (có nhân chứng) sẽ mất 0,1 DR."
		""
		"2. Giết người lùn khi có người lùn chưa thuần phục khác ở gần sẽ mất 1 DR."
		""
		"3. Tiêu diệt ma vật đang tấn công người lùn (cứu người lùn) sẽ nhận 1 DR."
		""
		"4. Mỗi lần nâng cấp độ giao dịch của thương nhân người lùn, nhận 0,1 DR."
		""
		"5. Mỗi lần mua vật phẩm bằng xu vàng, nhận 0,05 DR."
		""
		"6. Mỗi lần bán vật phẩm lấy xu vàng, nhận 0,01 DR."
		""
		"&6Nếu DR dương, mỗi điểm giúp giảm 0,5% giá giao dịch với người lùn."
		"&6Nếu DR âm, mỗi điểm khiến giá giao dịch với người lùn tăng 2%.&r"
	]
	quest.56413501A9E9D8FC.quest_subtitle: "Đừng gây chuyện!"
	quest.56413501A9E9D8FC.title: "Hệ thống Danh Vọng Người Lùn"
	quest.565894017692BCC7.quest_desc: [
		"&lHướng dẫn học kháng tính&r"
		""
		"Kháng tính chia theo độ khó học: Dễ / Trung Bình / Khó. Mỗi mức có yêu cầu riêng."
		"&lDễ:&r Nhận hơn 5 sát thương trong một đòn để được 1 điểm học. Cần 350 điểm để học hoàn toàn."
		"&lTrung Bình:&r Nhận hơn 15 sát thương trong một đòn để được 1 điểm học. Cần 500 điểm để học hoàn toàn."
		"&lKhó:&r Nhận hơn 20 sát thương trong một đòn để được 1 điểm học. Cần 700 điểm để học hoàn toàn."
		""
		"Độ khó mặc định của từng kháng tính:"
		"&lDễ:&r Ăn Mòn, Độc và Tê Liệt."
		"&lTrung Bình:&r Đau Đớn, Đâm Xuyên, Công Kích Tự Nhiên và Công Kích Thần Thánh. Công Kích Tự Nhiên gồm 7 nguyên tố chính, Trọng Lực, Sét, Nhiệt và Lạnh."
		"&lKhó:&r Công Kích Vật Lý, Ma Pháp, Công Kích Linh Hồn và Trạng Thái Bất Thường."
		""
		"Vẫn có thể học kháng tính từ sát thương thấp hơn ngưỡng."
		"Sát thương dưới ngưỡng được tích luỹ. Khi tổng đạt gấp 10 lần ngưỡng sát thương, nhận 1 điểm học."
		"Ví dụ, Kháng Công Kích Vật Lý yêu cầu nhận hơn 20 sát thương trong một đòn để được 1 điểm học."
		"Nếu nhận dưới 20 sát thương, chẳng hạn 12, kỹ năng chưa nhận điểm học ngay mà tích 12 \"Điểm Sát Thương\". Khi tích đủ 200, tức 20 × 10, kỹ năng nhận 1 điểm học."
		"Mỗi khi kỹ năng nhận 1 điểm học, \"Điểm Sát Thương\" đặt lại về 0."
		""
		"{@pagebreak}"
		"Làm gì khi sinh vật có kháng tính?"
		"Với Kháng Vật Lý khó chịu nhất, cách giải quyết đơn giản là đổi sang sát thương nguyên tố hoặc ma pháp. Kháng Vật Lý chỉ chặn sát thương vật lý, nên kỹ năng Hoả và đòn ma pháp không bị ảnh hưởng."
	]
	quest.56987D716B42A309.quest_desc: ["Không hồi thanh no, nhưng ăn xong thì ta cá bạn sẽ rất lâu mới đói lại."]
	quest.56987D716B42A309.quest_subtitle: "Hiệu quả còn tốt hơn Táo Vàng Phù Phép"
	quest.56987D716B42A309.title: "Món ăn vô cùng ngon miệng"
	quest.57148A7A115AD70E.quest_desc: [
		"Sách Linh Khí Tự Nhiên chỉ vị trí đặt từng thứ. Mở mục “Nghi Thức Rừng”, chọn sơ đồ tương ứng, rồi nhấp biểu tượng “con mắt” ở góc dưới trái để hiển thị trực quan."
		""
		"Cũng có thể xem công thức nghi thức tương ứng trong EMI (JEI)."
		""
		"&#FFB969Để dùng chất xúc tác, chế tạo bốn cái và đặt trên Gạch Đá Vàng ở bốn góc Tế Đàn Tự Nhiên."
	]
	quest.57148A7A115AD70E.quest_subtitle: "Nghi thức là phần quan trọng của mod này"
	quest.57148A7A115AD70E.title: "Chuẩn bị nghi thức"
	quest.576F41DB3BC82B6B.quest_desc: [
		"&lCách nhận:&r"
		"Tìm trong Thành Phố Cổ (0,5%)"
		"Tìm trong Tàn Tích Pháo Đài Piglin và Thành Phố End (1%)"
		"Có cơ hội tìm thấy trong lâu đài của Luminous."
		""
		"Giữ chuột phải để dùng ma cụ hiếm này biến thành ma vật, tiêu hao một nửa máu tối đa và phần lớn Ma Tố hiện tại. &4Nếu đã là ma vật thì đừng dùng, sẽ lãng phí!&r"
	]
	quest.576F41DB3BC82B6B.quest_subtitle: "Trở thành ma vật?"
	quest.576F41DB3BC82B6B.title: "&6【Nhiệm Vụ Phụ · Cốt Lõi】&rTrái Tim Khôi Lỗi"
	quest.57DA23777912E5F0.quest_desc: ["Dựa vào tia sét bật ngược để đánh trúng bản thể Boss."]
	quest.57DA23777912E5F0.quest_subtitle: "Từ Bi/Bác Ái/Ân Huệ/Khoan Dung"
	quest.57DA23777912E5F0.title: "Đánh bại Từ Bi"
	quest.57DB5A8781F58A99.quest_subtitle: "[Chọn một tuyến, chơi đơn cũng có thể khiêu chiến tất cả]"
	quest.57EB4AAC9C405916.quest_subtitle: "Yếu hơn Giáp Kim Cương một chút"
	quest.57EB4AAC9C405916.title: "Bộ giáp Nhện Giáp Chân Thương"
	quest.58020190DBD3261D.quest_desc: [
		"Cách nhận: Sở hữu Cảm Tri Ma Lực và thông thạo Cảm Tri Nguy Hiểm; hoặc dùng Hấp Thu & Phân Giải của Slime, Kẻ Săn Mồi hay năng lực đoạt kỹ năng lên Dơi, Warden hoặc Dơi Khổng Lồ."
		""
		"&l[Bị động - Bật/Tắt]: &r"
		"Khi bật, thực thể phát ra tiếng động trong bán kính 20 khối có viền xanh lá."
	]
	quest.58020190DBD3261D.quest_subtitle: "Radar ư?"
	quest.584BAF7043424C0B.quest_desc: "Bạn có biết? Người sở hữu Kỹ năng Độc nhất Đầu Bếp có thể tạo thức ăn mang chỉ số EP, Ma Tố hoặc Đấu Khí."
	quest.584BAF7043424C0B.quest_subtitle: "Đầu bếp ư?"
	quest.588CD7186D1599EE.quest_desc: [
		"Dùng chổi quét Cát Đáng Ngờ trong kim tự tháp để có cơ hội nhận được."
		"Cầm dây chuyền nhấp chuột phải vào Cổ Hồn đang ngủ để đánh thức."
	]
	quest.588CD7186D1599EE.quest_subtitle: "Dây chuyền chôn trong cát"
	quest.5919C85A1A49C857.quest_subtitle: "Tránh xa ta ra"
	quest.591D9D51C0DFAACA.quest_desc: [
		"&6EP mặc định: 1000, tối đa 100.000"
		"&6Tiêu diệt sinh vật có thể tăng EP, nhưng vũ khí không thể tiến hoá."
	]
	quest.59F847D65743536C.quest_desc: [
		"Có tỉ lệ 1% nhận từ rương trong Tháp Pháp Sư Đổ Nát."
		"&6Tiêu thụ 10 vật phẩm để mở quyền khoá kỹ năng Thời Gian Chi Vương.&r"
	]
	quest.5A54C9E87F1CE967.quest_desc: [
		"&#FFED54Liên kết:&r"
		"[{\"text\": \"Cách hoạt động của Cổ Vật\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"4DB740093C0BA804\"}}]"
		""
		"Hiệu ứng mặc định"
		"&5Hiệu ứng 1: Tốc Niệm"
		"Tăng tốc độ thi triển ma pháp 10%."
		"Hiệu ứng có tác dụng khi trang bị cổ vật và đã mở khoá hiệu ứng."
		"&5Hiệu ứng 2: Dòng Chảy Thông Thạo"
		"Tăng tốc độ thông thạo năng lực 100%."
		"Hiệu ứng có tác dụng khi trang bị cổ vật và đã mở khoá hiệu ứng."
		""
		"Thưởng tinh luyện"
		"Tăng trưởng Tốc Niệm"
		"Mỗi lần tinh luyện dành cho Tốc Niệm tăng thêm 2% tốc độ thi triển ma pháp."
		"Tối đa: Ở mức tinh luyện +5, Tốc Niệm tăng tối đa 20% tốc độ thi triển ma pháp."
		"Tăng trưởng Dòng Chảy Thông Thạo"
		"Mỗi lần tinh luyện dành cho Dòng Chảy Thông Thạo tăng thêm 10% tốc độ thông thạo."
		"Tối đa: Ở mức tinh luyện +5, Dòng Chảy Thông Thạo tăng tối đa 150% tốc độ thông thạo năng lực."
	]
	quest.5A54C9E87F1CE967.title: "&6【Cổ Vật】&fCổ Vật Viễn Cổ Bậc 2"
	quest.5A6FAC9B1299143D.title: "Hoàn thành Uỷ Thác Hôm Nay"
	quest.5A8DA43E6867223E.quest_subtitle: "Nguyên liệu chế tạo"
	quest.5A8DA43E6867223E.title: "Nguyên liệu chế tạo Bàn Hiến Tế"
	quest.5B38049D9A708555.quest_subtitle: "Thật sự ổn chứ?"
	quest.5B38049D9A708555.title: "Thảo phạt Thủ Lĩnh Giáo Hội"
	quest.5B4ADF4349E0110E.title: "&6【Nhiệm Vụ Phụ】&rTăng tốc hồi phục!"
	quest.5B7AD240B09DE51C.title: "{translate:\"task.DD4E5F6A7B8C9013.title\"}"
	quest.5B92703EF242240B.quest_desc: [
		"&8Bạn có thể gia nhập Hiệp Hội Tự Do. Để tìm đường đến đó, trước tiên hãy nhận và hoàn thành ba uỷ thác của người lùn để lấy bản đồ."
		"{image:ablazeaqzlcz:textures/ftb/df_q.png width:100 height:100 align:center}"
		""
		"Sau khi gia nhập, nhận các uỷ thác từ NPC Yuuki để nâng hạng mạo hiểm giả, tối đa Hạng S. Hạng càng cao, thưởng càng tốt! Một số nhiệm vụ thảo phạt có thể rất hợp với bạn!"
		""
		"&l&4Hoặc có lẽ... hãy ngăn chặn Yuuki!"
	]
	quest.5B92703EF242240B.quest_subtitle: "Đến đó bằng cách nào?"
	quest.5B92703EF242240B.title: "Hiệp Hội Tự Do?"
	quest.5BB396353EB783E3.quest_desc: ["Hồi 30% MP sau khi uống"]
	quest.5BB396353EB783E3.quest_subtitle: "Nhận từ người lùn giả kim"
	quest.5BC16D805F2BC6FA.quest_desc: ["&6Rơi từ Wither với tỉ lệ 20%.&r Khi sở hữu Azathoth, Hư Không Chi Thần, tiêu thụ 10 vật phẩm để khoá Kỹ năng Tối thượng trong menu “Khoá”, giúp giữ lại khi chuyển sinh."]
	quest.5C1916C1CDFAD8A1.quest_desc: ["Hồi 20% MP sau khi uống"]
	quest.5C1916C1CDFAD8A1.quest_subtitle: "Nhận từ người lùn giả kim"
	quest.5C4E0D0411A674BB.quest_desc: ["&lSau khi tiến hoá thành Orc Tai Hoạ, hắn nhận Kỹ năng Độc nhất — &5Kẻ Đói Khát&r&r"]
	quest.5C4E0D0411A674BB.quest_subtitle: "\"Giúp Gade\""
	quest.5C4E0D0411A674BB.title: "Đánh bại! Orc Tai Hoạ"
	quest.5C9134F3F3AA5C2F.quest_desc: [
		"Giữ phím kích hoạt để nhận hiệu ứng bay lên tương tự Shulker."
		""
		"&8Đây là bay lên trên, không phải bay tự do như chế độ Sáng Tạo hay bay tiến về trước."
		"&6Mở khoá học khi đạt 10.000 EP"
	]
	quest.5C9134F3F3AA5C2F.quest_subtitle: "Ta bị Shulker đánh à?"
	quest.5C9134F3F3AA5C2F.title: "&6【Mẹo Tân Thủ】&rKỹ năng tuỳ chọn [Phi Hành Trọng Lực]"
	quest.5CAB6913DE075CEB.quest_desc: [
		"Mở cửa bằng Chìa Khoá Đại Đồng Hồ"
		""
		"&8Từng là cơ quan cốt lõi của Bình Minh Thời Gian, Đại Đồng Hồ là trung tâm mà mọi tháp đồng hồ, bảo khố và cổng dịch chuyển đều hướng đến. Thợ đồng hồ tin rằng nếu điều khiển được nó, họ có thể bắt thời gian tuân ý mình: đảo ngược thương tích, làm cây trồng chín tức thì và đưa thành phố về ngày hôm trước để tránh tai hoạ."
		"&8Họ xây Đại Đồng Hồ ở nơi sâu nhất của chiều không gian, duy trì bằng vô số bánh răng, Đá Đồng Hồ và Tinh Thể Thời Gian. Mỗi hành lang khắc những công thức thời gian chính xác; sau mỗi cánh cửa là cơ quan ổn định thế giới. Khi ấy, nơi đây là thánh điện thờ thời gian."
		"&8Cho đến khi lần \"Đình Trệ\" đầu tiên xảy ra."
		""
		"&8Khi Đại Đồng Hồ ngân tiếng thứ mười ba, thời gian trong toàn bộ mê cung dừng lại."
		"&8Vệ binh tuần tra đông cứng giữa bước chân, lửa cháy hoá rắn giữa không trung, bóng những thợ đồng hồ bị ghim lên tường. Chỉ Đại Đồng Hồ tiếp tục quay, mỗi lúc một nhanh."
		"&8Không ai biết Bạo Chúa Thời Gian thật sự đến từ đâu."
		"&8Có người nói đó là ý chí sinh ra từ chính Đại Đồng Hồ."
		"&8Có người nói đó là quái vật kết tụ từ vô số thí nghiệm thất bại, thợ đồng hồ đã chết và thời gian vỡ vụn."
		"&8Cũng có người cho rằng đó là sự trả đũa của thời gian trước lòng kiêu ngạo của con người."
		"&8Từ đó, Mê Cung Đại Đồng Hồ bị phong kín. Lối vào chỉ đáp lại Chìa Khoá Đại Đồng Hồ; tường được sức mạnh Bạo Chúa Thời Gian bảo vệ, không công cụ thường nào phá nổi. Ai tiến vào đại sảnh trung tâm đều nghe tiếng chuông trầm từ xa, như đếm ngược đến hồi kết của chính mình."
		""
		"&8Nhưng Đại Đồng Hồ vẫn chưa dừng."
		"&8Mỗi vòng quay, Bình Minh Thời Gian lại tiếp tục đông cứng."
		"&8Rừng không thật sự lớn lên, sóng không thật sự tiến tới; ngày đêm bị xé thành những mảnh hỗn loạn. Cả chiều không gian mắc kẹt trong cùng một buổi bình minh không bao giờ kết thúc."
	]
	quest.5CAB6913DE075CEB.quest_subtitle: "Công trình huy hoàng nhất của thợ đồng hồ cổ đại"
