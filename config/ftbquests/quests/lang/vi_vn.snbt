	quest.2936183B86B29BD1.title: "Thu thập trứng rồng"
	quest.298D2956301C4909.quest_subtitle: "Sinh vật kỳ lạ ở quần xã Đảo Nấm"
	quest.298D2956301C4909.title: "Người Nấm ư?"
	quest.29A111B8AA05196C.quest_desc: ["Để vào Rừng Chạng Vạng, hãy tạo hồ 2×2 có hoa bao quanh, rồi ném một Mảnh Ma Khoáng vào để kích hoạt cổng."]
	quest.29A111B8AA05196C.quest_subtitle: "Bạn cần một Mảnh Ma Khoáng"
	quest.29D5A0C139127B44.quest_desc: [
		"Có thể gặp nó bên dưới ngôi đền ven biển"
		""
		"&8Ánh mắt của nó đủ giết bạn, dù bạn mạnh đến đâu..."
		"&8Có thể chế tạo &6Bịt Mắt&r&8 để che mắt mình, nhưng mạo hiểm giả dày dạn thường cúi đầu khi tấn công nó."
	]
	quest.29D5A0C139127B44.quest_subtitle: "Đừng nhìn vào mắt nó!"
	quest.29D5A0C139127B44.title: "Thảo phạt Xà Nữ Medusa"
	quest.29D96A1CE4910C8B.quest_desc: "&6Rơi từ Rimuru, Slime Siêu Khổng Lồ và Luminous. &rTiêu thụ để tăng tốc học kỹ năng trong 10 phút. Nếu sở hữu Đại Hiền Giả, Hiền Giả hoặc Trí Tuệ Chi Vương, bạn còn nhận thêm độ thông thạo. Khi sở hữu Trí Tuệ Chi Vương, tiêu thụ 10 vật phẩm để khoá Kỹ năng Tối thượng trong màn hình \"Khoá\", giúp giữ lại kỹ năng khi chuyển sinh."
	quest.2A243EB62B7E854E.title: "Đánh bại Thiết Chưởng Nether"
	quest.2A28C48839DFA9E9.quest_desc: [
		"Ma Đạo Thư Hạng D xuất hiện trong rương của các tháp pháp sư:"
		""
		"Tháp Pháp Sư Đổ Nát"
		"Tháp Pháp Sư Mục Nát"
		"Tháp Pháp Sư Băng Giá"
		"Tháp Pháp Sư Chôn Vùi"
		"Tháp Pháp Sư Cháy Rụi"
		""
		"Hoặc trong rương nhà huấn luyện ma pháp tại làng người lùn"
	]
	quest.2A616C1ABBDB8D9D.quest_desc: ["Tiến hoá thành trượng cao cấp khi đạt 52.000 EP."]
	quest.2A93D5CB30B2A010.title: "Thượng Cấp Quỷ Ăn Thịt Người"
	quest.2AC171130361F94C.title: "{translate:\"task.C3D4E5F6A7B80122.title\"}"
	quest.2ACC936488DB77EF.quest_desc: "Đánh bại Feldway để nhận."
	quest.2ACC936488DB77EF.quest_subtitle: "Điều kiện↓"
	quest.2ACC936488DB77EF.title: "&6【Nâng Cao】&fKỹ năng Tối thượng Ronova"
	quest.2AFA42AFC1F22F78.quest_subtitle: "Có thể hơi yếu hơn Ma Cương Sinh Học"
	quest.2AFA42AFC1F22F78.title: "Bộ giáp Charybdis"
	quest.2B3C4D5E6F7A8901.title: "{translate:\"task.2B3C4D5E6F7A8902.title\"}"
	quest.2B40902E17F81207.quest_desc: [
		"Sau khi bước vào cảnh giới Trúc Cơ, người chơi nhận ngẫu nhiên một linh căn."
		"Mỗi linh căn ban một tinh linh nguyên tố hạ cấp tương ứng, cùng các cường hoá năng lực riêng."
		""
		"&4Hoả Linh Căn&r"
		"Ban Hoả Tinh Linh hạ cấp."
		"Hiệu quả:"
		"Tăng khả năng kiểm soát nhiệt độ khi luyện đan."
		"Ở gần lò luyện đan sẽ rút ngắn thêm thời gian điều chế."
		""
		"&9Thuỷ Linh Căn&r"
		"Ban Thuỷ Tinh Linh hạ cấp."
		"Hiệu quả:"
		"Cung cấp khả năng hồi phục liên tục."
		"Hồi máu và Ma Tố bị động."
		""
		"&bPhong Linh Căn&r"
		"Ban Phong Tinh Linh hạ cấp."
		"Hiệu quả:"
		"Cường hoá khả năng di chuyển."
		"Tăng trực tiếp tốc độ di chuyển của người chơi."
		""
		"&#93452AThổ Linh Căn&r"
		"Ban Thổ Tinh Linh hạ cấp."
		"Hiệu quả:"
		"Cung cấp năng lực chiến đấu cơ bản và kháng tính tương ứng với Thổ Tinh Linh."
		""
		"&fHư Không Linh Căn"
		"Ban Không Gian Tinh Linh hạ cấp."
		"Hiệu quả:"
		"Cung cấp các năng lực cơ bản như Dịch Chuyển Không Gian và Kháng Không Gian."
	]
	quest.2B51A873B4182555.quest_desc: [
		"&#FFED54Liên kết:&r"
		"[{\"text\": \"Cách hoạt động của Cổ Vật\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"4DB740093C0BA804\"}}]"
		""
		"Hiệu ứng mặc định"
		"&5Hiệu ứng 1: Hoả Ngục Dâng Trào"
		"Khi người đeo chiến đấu, sát thương Hoả tăng dần từng 1%."
		"Hoả Ngục Dâng Trào cộng một tầng mỗi 3 giây, tối đa tăng 20% sát thương Hoả."
		"&5Hiệu ứng 2: Cường Hoá Hắc Viêm Ngục"
		"Tăng 50% sát thương Hắc Viêm Ngục Giới Hạn."
		"&5Hiệu ứng 3: Cuồng Nộ Có Kiểm Soát Của Chỉ Huy"
		"Mở khoá khi người đeo sở hữu Kỹ năng Độc nhất Chỉ Huy Giả."
		"Cuồng Nộ Có Kiểm Soát Của Chỉ Huy nâng cấp Cổ Vũ và giảm Ma Tố tiêu hao dựa trên MP/Ma Tố hiện tại của người đeo."
		"MP/Ma Tố hiện tại càng thấp, mức giảm chi phí Ma Tố càng mạnh."
		""
		"Thưởng tinh luyện"
		"Tăng trưởng Hoả Ngục Dâng Trào"
		"Mỗi lần tinh luyện dành cho Hoả Ngục Dâng Trào giảm 0,25 giây giữa các lần cộng tầng sát thương Hoả."
		"Tối đa: Hoả Ngục Dâng Trào nhận tối đa 2 lần tinh luyện, giảm thời gian cộng tầng xuống 2,5 giây."
		"Tăng trưởng Cường Hoá Hắc Viêm Ngục"
		"Mỗi lần tinh luyện dành cho Cường Hoá Hắc Viêm Ngục tăng thêm 10% sát thương Hắc Viêm Ngục Giới Hạn."
		"Tối đa: Ở mức tinh luyện +3, Cường Hoá Hắc Viêm Ngục tăng tối đa 80% sát thương Hắc Viêm Ngục Giới Hạn."
		"Tăng trưởng Cuồng Nộ Có Kiểm Soát Của Chỉ Huy"
		"Mỗi lần tinh luyện dành cho Cuồng Nộ Có Kiểm Soát Của Chỉ Huy thay đổi 5% ngưỡng Ma Tố thiếu hụt dùng cho mỗi bậc giảm chi phí Ma Tố."
	]
	quest.2B51A873B4182555.title: "&6【Cổ Vật】&fCổ Vật Viễn Cổ Bậc 1"
	quest.2B5B4F80FF58C22F.quest_desc: ["Nếu đánh chỉ như gãi ngứa, hãy ghép thành &4Kiếm Đá Suối Nóng&r!"]
	quest.2B5B4F80FF58C22F.title: "Dây Leo Nguyệt Quang Khổng Lồ? Thiêu rụi nó!"
	quest.2B64F0E323A0A8EA.quest_desc: [
		"&l[Chủ động - Giữ phím]:&rKhi giữ phím, người chơi chuyển sang góc nhìn 360°, xa hơn một chút so với góc nhìn thứ ba thông thường."
		""
		"&6Yêu cầu hơn 5000 EP"
	]
	quest.2B64F0E323A0A8EA.quest_subtitle: "Có viền ngắm rồi mà vẫn đánh trượt sao?"
	quest.2B64F0E323A0A8EA.title: "&6【Mẹo Tân Thủ】&rKỹ năng đầu game cần có [Thiên Nhãn]"
	quest.2B8533422784771E.quest_desc: [
		"Miễn nhiễm độc cơ bản hoặc giảm tác dụng của độc"
		"&6&lKháng Độc [Mở khoá Bách Khoa]"
		"{image:ablazeaqzlcz:textures/ftb/curios/antidote_vessel.png width:50 height:80 align:left}"
	]
	quest.2B8533422784771E.quest_subtitle: "Giải độc"
	quest.2C2C9E868AC963D5.quest_desc: [
		"{image:ablazeaqzlcz:textures/ftb/quest.png width:155 height:100 align:center}"
		"Hoàn thành các nhiệm vụ bên trong để nhận \"Tinh Hoa Chuyển Sinh\". Hệ thống này liên kết với việc chuyển sinh của người chơi; chỉ khi đủ điều kiện mới có thể chuyển sinh."
		""
		"Chuyển sinh giúp tăng cấp linh hồn; chuyển sinh chủng tộc mang lại mức tăng trưởng lớn hơn."
		"Các hiệu quả bổ sung hiện có thể mở khoá:"
		"1. Giảm độ thông thạo bị mất của kỹ năng đã khoá khi đặt lại"
		"2. Tăng xác suất nhận uỷ thác hiếm"
		"3. Có cơ hội nhận thêm uỷ thác"
	]
	quest.2C2C9E868AC963D5.quest_subtitle: "&6【Giai đoạn hiện tại có thể tạm bỏ qua hệ thống này】"
	quest.2C746CE4537BB8EB.quest_desc: [
		"Tế Đàn Tự Nhiên thu linh khí trong phạm vi khoảng 20 khối, chứa tối đa khoảng 500.000 linh khí."
		"Các công thức truyền linh khí chính:"
		"Thỏi Sắt → Thỏi Sắt Truyền Linh Khí"
		"Đá → Đá Truyền Linh Khí"
		""
		"Xem thêm công thức trong EMI (JEI)."
	]
	quest.2C746CE4537BB8EB.quest_subtitle: "Hấp thu linh khí tự nhiên"
	quest.2D67CE51F7110224.quest_desc: "Nhấp chuột phải để đặt xuống đất. Nó sẽ hấp thu linh khí xung quanh và chuyển hoá thành các loại quặng. Quá trình này cần lượng lớn linh khí."
	quest.2D67CE51F7110224.quest_subtitle: "Chuyển đá xung quanh thành các loại quặng"
	quest.2DA0976EFC249F4A.title: "Đánh bại Vu Yêu Bóng Đêm"
	quest.2DB4047F56352F3B.quest_subtitle: "Đã đến lúc trở thành Ma Vương"
	quest.2DB4047F56352F3B.title: "&6【Cốt Truyện Chính】&rĐạt 200.000 EP"
	quest.2DE2EA8E74C55722.quest_subtitle: "[Nhấp để nộp nhiệm vụ sau khi nhận Mầm Mống Anh Hùng]"
	quest.2DE2EA8E74C55722.title: "&6【Con Đường Anh Hùng】&rNhận Mầm Mống Anh Hùng"
	quest.2E0D203C4166C35C.quest_desc: ["Tinh Hoa Chuyển Sinh là tài nguyên bắt buộc để chuyển sinh. Chỉ khi đủ lượng yêu cầu, người chơi mới có tư cách chuyển sinh. Tinh hoa bị xoá sau mỗi lần chuyển sinh; lượng cần thiết tăng theo số lần đã chuyển sinh."]
	quest.2E0D203C4166C35C.quest_subtitle: "Chỉ nhận được khi hoàn thành Uỷ Thác Vinh Dự"
	quest.2E3BE90938EB4D75.quest_subtitle: "Xác suất rơi"
	quest.2E52B4F14A7EE943.quest_desc: ["Rồng cái từ giai đoạn trưởng thành cấp 4 trở lên có thể rơi 0–3 trứng. &6Chúng đều xuất hiện dưới lòng đất."]
	quest.2E52B4F14A7EE943.quest_subtitle: "Rồng trên mặt đất còn quá nhỏ!"
	quest.2E52B4F14A7EE943.title: "Lấy trứng rồng thế nào?"
	quest.2E8290C05CD68FB4.quest_subtitle: "[Nhấp để nộp nhiệm vụ sau khi nhận được tinh linh tương ứng]"
	quest.2E8290C05CD68FB4.title: "Thuỷ Tinh Linh · Hạ Cấp"
	quest.2EF2C89BAEBD2D85.quest_desc: "&6Có thể tìm nơi này bằng toạ độ nhận được khi giao dịch với Người Canh Giữ Thời Gian"
	quest.2EF2C89BAEBD2D85.quest_subtitle: "Xưởng ngầm nơi những thợ đồng hồ cổ đại chế tạo đội quân cơ giới"
	quest.2F5EA5DA32178D88.quest_subtitle: "Nhận thông qua chuyển sinh hoặc các cách khác"
	quest.2F5EA5DA32178D88.title: "&6【Nâng Cao】&fSở hữu Kỹ năng Độc nhất Đại Hiền Giả"
	quest.2F8F7C3215DD9101.quest_desc: [
		"Vũ khí có tầm đánh xa; chuột phải còn phóng lôi cầu, có thể trực tiếp gây sát thương chính diện lên Hoả Ma."
		"&6EP mặc định: 0"
		"&6Tiêu diệt sinh vật có thể tăng EP, nhưng vũ khí không thể tiến hoá."
	]
	quest.2F8F7C3215DD9101.quest_subtitle: "Lao móc phóng sét"
	quest.2F9A16CFA0549969.quest_subtitle: "Có vảy nhọn và lớp da bền chắc"
	quest.2F9A16CFA0549969.title: "Xà ma hùng mạnh trong Phong Ấn Động"
	quest.3091985C0E95C53F.quest_desc: [
		"Có thể đổi bản đồ công trình này với Dân Làng Vẽ Bản Đồ, hoặc tìm nó sinh ra tự nhiên ngoài hoang dã."
		""
		"Trong một trận không kích thời Thế chiến II, Izawa Shizue đã được &4Ma Vương Leon Cromwell&r triệu hồi sang dị giới."
		""
		"Để giữ cô sống sót, Leon cưỡng ép dung hợp Hoả Tinh Linh \"Ifrit\" vào cơ thể cô, biến cô thành \"Viêm Ma Nhân\"."
		"{image:ablazeaqzlcz:textures/ftb/ifrit_shizu.png width:100 height:100 align:center}"
		"Vì vậy, muốn &bgiải thoát Izawa Shizue&r, bạn phải đánh bại &4Hoả Tinh Linh Ifrit&r"
	]
	quest.3091985C0E95C53F.quest_subtitle: "Viêm Ma Nhân"
	quest.3091985C0E95C53F.title: "&6【Tuyến Thử Thách ①】&rDị Giới Nhân căm ghét Slime..."
	quest.30A3566EB22079CA.quest_desc: [
		"&6Nguyên liệu quan trọng để chế tạo khôi lỗi"
		""
		"Khi có kỹ năng Chiếm Hữu, bạn có thể dùng các khôi lỗi này làm thể xác mới, kế thừa máu của Khôi Lỗi Xương mà không ảnh hưởng đến chủng tộc hay ma lực."
		"&8Ví dụ: Từ 20 máu, chiếm hữu Khôi Lỗi Xương 400 máu sẽ nhận thể xác có 400 máu"
		""
		"Nếu bị tiêu diệt, Khôi Lỗi Xương trở về kho đồ"
	]
	quest.30A3566EB22079CA.quest_subtitle: "Chế tạo khôi lỗi"
	quest.30C4FEDFA9A5DB16.quest_desc: [
		"&6Lưu ý: Không dùng kỹ năng khi đang chạy hoạt cảnh, vì có thể làm trống các kỹ năng trên thanh phím tắt."
		""
		"Xuất hiện tại công trình lâu đài ở Thế Giới Thường."
	]
	quest.30C4FEDFA9A5DB16.quest_subtitle: "Rồng lâu đài"
	quest.30FB66CFE70278AD.quest_desc: "&6Có thể tìm nơi này bằng toạ độ nhận được khi giao dịch với Người Canh Giữ Thời Gian"
	quest.30FB66CFE70278AD.quest_subtitle: "Bảo Khố Thủ Hộ phong ấn lõi phòng vệ cổ xưa nhất của chiều không gian"
	quest.313C7B20500ED01E.title: "&#FF6854【Thu Hồi】&fKỹ năng Độc nhất"
	quest.31406DA796F5CD57.quest_desc: ["Hồi 10000 MP sau khi uống"]
	quest.31406DA796F5CD57.quest_subtitle: "Nước đun sôi có khác"
	quest.315C6016D88D781D.quest_desc: [
		"Miễn nhiễm sát thương sét"
		"&6&lKháng Sét [Mở khoá Bách Khoa]"
		"{image:ablazeaqzlcz:textures/ftb/curios/shock_pendant.png width:50 height:80 align:left}"
		""
		"Phóng sét đánh đối thủ"
		"&6&lLôi Điện Hộ Vệ [Mở khoá Bách Khoa]"
		"{image:ablazeaqzlcz:textures/ftb/curios/shock_pendant_2.png width:50 height:80 align:left}"
	]
	quest.315C6016D88D781D.quest_subtitle: "Tia chớp"
	quest.318F8A3B3BBD8349.quest_desc: [
		"Người lùn tương tự dân làng, có thể giao dịch; tay nghề thủ công của họ đứng đầu thế giới!"
		"Giao dịch với họ cần tiền xu, thay vì ngọc lục bảo."
		"{image:ablazeaqzlcz:textures/ftb/dwarf_village.png width:130 height:70 align:center}"
		""
		"Ở các thành bang lớn, bạn còn gặp pháp sư người lùn để đổi &5Ma Đạo Thư&r kỳ lạ, hoặc đổi &5Bản Thiết Kế Ma Trượng&r với đại pháp sư."
	]
	quest.318F8A3B3BBD8349.quest_subtitle: "Tìm nơi người lùn sinh sống"
	quest.318F8A3B3BBD8349.title: "Thủ đô người lùn"
	quest.321ECD9F13D78465.quest_subtitle: "【Thông Thạo】"
	quest.321ECD9F13D78465.title: "&6【Nâng Cao】&fSở hữu Kỹ năng Độc nhất Vô Hạn Lao Ngục"
	quest.3228ABCCB6B932FC.title: "{translate:\"task.D4E5F6A7B8C90133.title\"}"
	quest.325BE865B5571472.title: "Thảo phạt Thái Dương Điểu - Umuwuti"
	quest.32E1EA9C678DFF9C.quest_desc: ["Rãnh giữa là nơi lấy thành phẩm; các thanh hai bên dùng để nấu chảy và chứa khoáng vật trong bộ phận dung hợp."]
	quest.32E1EA9C678DFF9C.quest_subtitle: "Ôi, luyện thế nào đây?"
	quest.32E1EA9C678DFF9C.title: "&6【Con Đường Rèn · Quan Trọng】&rLuyện khoáng, đúc thần khí"
	quest.32FEF370F61CA35C.quest_desc: ["&8Có thể vô ích với người có bản đồ, nhưng nếu là hang rồng dưới lòng đất thì sao?"]
	quest.32FEF370F61CA35C.quest_subtitle: "Vật phẩm tìm rồng?"
	quest.332803BFA6D1A237.quest_subtitle: "Nữ hoàng từ lâu đài băng"
	quest.33334EFC5EC1E3B6.quest_desc: ["Miễn nhiễm mọi đòn đánh và hiệu ứng thông thường. Tấn công bình thường gần như không làm nó mất máu."]
	quest.33334EFC5EC1E3B6.quest_subtitle: "Những điều cần biết"
	quest.337C56118E98F19E.title: "{translate:\"task.8B9C0D1E2F3A4568.title\"}"
	quest.33A31F36D0204245.quest_desc: [
		"Có hai giai đoạn. Giai đoạn đầu dùng toàn bộ chiêu thức; giai đoạn sau cường hoá các năng lực trước đó."
		"&6Kỹ năng của nó gồm Vô Hiệu Công Kích Hoả, Vô Hiệu Nhiệt, Vô Hiệu Trạng Thái Bất Thường, Cường Hoá Cơ Thể và Cương Lực."
	]
	quest.33A31F36D0204245.title: "Thảo phạt Quái Vật Netherite"
	quest.33AB6B567959623B.quest_desc: ["Xuất hiện ở tầng hai Đấu Trường Hoả Diễm. Tiêu diệt nó để nhận bốn Tàn Than; dùng chúng tạo &lThan Hồng Rực Cháy&r rồi cầm nhấp chuột phải vào Tế Đàn Hoả Diễm để triệu hồi Hoả Ma."]
	quest.33AB6B567959623B.quest_subtitle: "Anh em của Quỷ Lửa à?"
	quest.33AB6B567959623B.title: "Thảo phạt Di Vật Rực Cháy"
	quest.33C7424919F54C10.quest_desc: [
		"&6&lNày, người chuyển sinh, cho tôi thêm chút thời gian nhé. Tôi vẫn đang làm và cải thiện nội dung."
		""
		""
		"Bạn có biết? &6Mod cốt lõi Mysticism&r có nội dung DLC, nhưng phải hai tuần nữa mới cài được mod!"
		"&8*Lưu ý: Nếu gặp lỗi, hãy báo cho chúng tôi qua &5Discord&r&8 hoặc &r&bnhóm QQ&r&8!&r&r"
		"Được rồi, vào việc thôi. &6👈Mở các mục bên trái để bắt đầu phiêu lưu!&r"
		""
		"&6&lBạn có biết?"
		""
		"[{\"text\": \"『Cách ép tải chunk』\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"7D00E143DC7B8D9E\"}}]"
	]
	quest.33C7424919F54C10.quest_subtitle: "Chúc mừng!"
	quest.3407EC8CA3F0C20F.quest_subtitle: "Bá chủ bầu trời"
	quest.3407EC8CA3F0C20F.title: "Vảy Charybdis"
	quest.346B9FB4CDBA827C.quest_subtitle: "Không có xẻng thì xào bằng gì?"
	quest.34C35E7555875A09.quest_subtitle: "Rơi khi tiêu diệt Quái Vật Netherite"
	quest.34D8E3A129C8B3D9.quest_desc: [
		"&l\"Bình Minh Thời Gian\""
		"Từ rất lâu trước, thời gian ở Thế Giới Thường không trôi theo một đường thẳng."
		"Trong thời đại cũ, một nhóm thợ đồng hồ phát hiện loại quặng kỳ lạ. Khác sắt và vàng, nó không im lặng. Nó khẽ rung trong đêm như ẩn giấu tiếng chuông vô hình. Họ gọi nó là Đá Đồng Hồ, dùng nó dựng tháp, khắc bản thiết kế và đúc bánh răng, mong mở cánh cổng nơi tận cùng thời gian."
		""
		"..."
		""
		"Nhưng những người đầu tiên bước vào Bình Minh Thời Gian không bao giờ trở lại. Sau khi họ đi qua, cổng chỉ còn một chiều. Những thợ đồng hồ cổ đại nhận ra thứ mình mở ra là một nhà tù bị thời gian phong kín..."
	]
	quest.34D8E3A129C8B3D9.quest_subtitle: "Thời không đảo loạn"
	quest.351D8C60DBC88BF8.quest_desc: [
		"Khi có 200.000 EP và Hạt Giống Ma Vương, bạn có thể bắt đầu thu &#FF6F01linh hồn&r bằng cách tiêu diệt sinh vật EP cao."
		"Ví dụ, tiêu diệt:"
		"Charybdis cho &#B90E74800 linh hồn&r"
		"Hinata cho &#B90E74518 linh hồn"
		"Cự Tượng Nguyên Tố (lần đầu) cho &#B90E74175 linh hồn"
		"Slime Kim Loại cho &#B90E74150 linh hồn"
		"Orc Tai Hoạ cho &#B90E74125 linh hồn"
		"Thượng Cấp Ác Ma cho &#B90E7470 linh hồn"
		""
		"Dĩ nhiên, sinh vật khác cũng cho linh hồn, miễn là chúng có EP."
		"&4Cảnh báo: Khi chết, bạn mất 5% số linh hồn!&r"
	]
	quest.35289058F397A21C.title: "&6【Cốt Truyện Chính】&rĐạt 1,8 triệu EP"
	quest.35606BC47E5DCBCF.quest_subtitle: "Tiêu diệt mà không nhận sát thương."
	quest.362F033FC7A21D59.quest_desc: [
		"Hiện chỉ có thể gặp cô ấy ngoài tự nhiên. Công trình sẽ được thêm trong bản cập nhật sau."
		"Năng lực của cô ấy chủ yếu là vật lý, nhưng hãy cẩn thận tuyệt chiêu!"
		""
		"&#FF5E30Boss này vẫn đang được phát triển.&r"
	]
	quest.362F033FC7A21D59.quest_subtitle: "Đừng nghịch nữa nào"
	quest.362F033FC7A21D59.title: "Bạn là Thánh Phồng à?"
	quest.36872A791869885E.quest_subtitle: "Lựa chọn tốt nhất để chế tạo vũ khí và trang bị"
	quest.36872A791869885E.title: "Mạnh hơn Netherite!"
	quest.37220E036887A3FD.title: "Taratect Hạ Cấp Cỡ Nhỏ"
	quest.3793BC9A3109DA3E.quest_desc: [
		"Dường như có một cuốn sách ghi chép về nó, có thể tìm trong cỏ Hipokute khắp thế giới. &5Loài cây này rất nhạy với Ma Tố&r, nên nơi có nồng độ Ma Tố cao sẽ dễ xuất hiện hạt giống hơn chăng?"
		""
		"Cách dùng: Trồng &2Hạt Hipokute&r trên khối cỏ, đất hoặc đất canh tác"
		"{image:tensura:item/hipokute_seeds width:20 height:20 align:center}"
		"&lCơ chế sinh trưởng ngẫu nhiên:&r"
		""
		"● Ở Thế Giới Thường, mỗi 0,05 giây có &610% xác suất&r hạt phát triển thành cây Hipokute."
		""
		"● &6Nếu trồng ở Minh Giới, xác suất tăng lên 25%!&r"
		""
		"● &690% còn lại&r biến thành lúa mì thường rồi tiếp tục sinh trưởng như lúa mì (75% tại Minh Giới)."
		"{image:tensura:item/hipokute_grass width:20 height:20 align:center}"
		"● Khi cây đạt giai đoạn \"cỏ\", sẽ có &650% xác suất&r trở thành &2&lCỏ Hipokute&r."
		""
		"{image:tensura:item/hipokute_flower width:20 height:20 align:center}"
	]
	quest.3793BC9A3109DA3E.quest_subtitle: "Tìm hạt giống đặc biệt này ở đâu?"
	quest.3793BC9A3109DA3E.title: "&6【Nhánh Luyện Dược】&rThu thập Hạt Hipokute"
	quest.379A02354D2E8B3C.quest_subtitle: "Đánh bại các Boss theo thứ tự"
	quest.37B21D9B564CCEBA.quest_desc: [
		"Dùng khoáng vật này để chế tạo vũ khí và trang bị là lựa chọn sáng suốt, nhưng nó hiếm không kém Mảnh Vỡ Cổ Đại."
		"Nếu định khai thác khoáng vật này, hãy chuẩn bị &6Cuốc Chim Netherite&r, nếu không bạn sẽ chẳng đào được gì!"
		""
		"Cũng có thể nhận 1–6 đơn vị khi tiêu diệt Slime Kim Loại, nhưng bạn có tìm ra và đuổi kịp chúng không? &6Chúng có Kháng Công Kích Vật Lý và năng lực tái sinh.&r"
	]
	quest.37B21D9B564CCEBA.quest_subtitle: "Tinh thể tràn đầy Ma Tố..."
	quest.37B21D9B564CCEBA.title: "&6【Con Đường Rèn · Quan Trọng】&rKhai thác khoáng vật quý hiếm"
	quest.37C4A1ED1E0E1822.title: "Taratect Hạ Cấp"
	quest.37E707CBDB2CDDCD.title: "{translate:\"task.B2C3D4E5F6A70901.title\"}"
	quest.381650201BD5521E.quest_desc: [
		"Chiếm hữu thể xác suy yếu để bước vào một thế giới hoàn toàn mới."
		"Cách dùng:"
		"&lKỹ năng chủ động&r Khi đang chiếm hữu, dùng kỹ năng để rời thể xác cùng các kỹ năng cố hữu của nó và chuyển sang Linh Thể. Trừ thể xác ban đầu, thân xác bị bỏ lại biến mất sau 5 phút để tránh lag. Ở dạng Linh Thể, có thể chiếm hữu mục tiêu đáp ứng điều kiện: [Vô hiệu với mục tiêu miễn nhiễm công kích linh hồn]"
		""
		"&l- Ma vật không phải người chơi: &r"
		"Máu dưới 10%, sinh lực linh hồn dưới 10% hoặc EP tối đa dưới 25% của người dùng. Nếu mục tiêu có Kháng Công Kích Linh Hồn, các ngưỡng tương ứng là 5%, 5% và 12,5% EP."
		""
		"&l- Người chơi:&r Cần thoả 2 trong 3 điều kiện trên. Người bị chiếm hữu chuyển sang Linh Thể và cuối cùng sẽ chết nếu không có kỹ năng [Chiếm Hữu]."
		"Khi chiếm hữu mục tiêu, người dùng trở lại dạng vật chất, nhận chỉ số thể chất và kỹ năng của mục tiêu."
		""
		"&lCảnh báo: Đồ cầm tay và giáp sẽ ở lại trên thể xác cũ khi dùng kỹ năng này.&r"
		""
		"&lNhắc nhẹ:&r Mở kho đồ của thể xác cũ để lấy lại vật phẩm."
		"Khi đổi thể xác bằng [Chiếm Hữu], chỉ hiệu ứng có nhãn \"tác động linh hồn\" được chuyển theo; hiệu ứng thông thường không đi cùng linh hồn."
	]
	quest.381650201BD5521E.quest_subtitle: "Kỹ năng nội tại của bạn"
	quest.381B864E35C59018.title: "{translate:\"task.E5F6A7B8C9D01244.title\"}"
	quest.38BE2F3E7F5B1C5F.quest_desc: "Nhấp chuột phải vào khung cổng để kích hoạt, rồi dùng Đồng Hồ Cát Thời Gian để mở lại cổng"
	quest.38BE2F3E7F5B1C5F.quest_subtitle: "Kích hoạt cổng trở về"
	quest.39472502FF781B84.quest_subtitle: "Tìm hang động bên trong [Chọn một tuyến; người chơi đơn có thể thử thách tất cả]"
	quest.395C303A0B300171.quest_desc: "&6Có tỉ lệ 1% rơi khi thu hoạch cây trồng chín.&r Khi sở hữu Shub-Niggurath, Phong Nhương Chi Vương, tiêu thụ 10 vật phẩm để khoá Kỹ năng Tối thượng qua màn hình “Khoá”, giúp giữ lại khi chuyển sinh."
	quest.395C303A0B300171.quest_subtitle: "Giữ lại kỹ năng này"
	quest.39A1084D05A08CDF.quest_desc: [
		"1. Yêu cầu 8.000.000 EP."
		"2. Yêu cầu thông thạo Điều Luật Giả."
	]
	quest.39A1084D05A08CDF.quest_subtitle: "Điều kiện↓"
	quest.39A1084D05A08CDF.title: "&6【Nâng Cao】&fKỹ năng Tối thượng Phù Thuỷ Hư Vinh"
	quest.39C80E7870D80734.quest_desc: [
		"Khiến Người Sắt không tấn công bạn!"
		"&6&lDiện Mạo Vô Hại【Mở khoá Bách Khoa】"
		"{image:ablazeaqzlcz:textures/ftb/curios/villager_hat_1.png width:50 height:80 align:left}"
		"&6&lBí Quyết Giao Thương【Mở khoá Bách Khoa】"
		"{image:ablazeaqzlcz:textures/ftb/curios/villager_hat_2.png width:50 height:80 align:left}"
	]
	quest.39C80E7870D80734.quest_subtitle: "Ta là dân làng"
	quest.3A3E98E35AA1FDAA.quest_desc: ["Có thể tìm chúng trong rương ở hang rồng hoặc công trình trong làng, nơi thường có Bàn Chép Bản Thảo."]
	quest.3A3E98E35AA1FDAA.quest_subtitle: "Bách khoa chưa hoàn thiện"
	quest.3A3E98E35AA1FDAA.title: "Thu thập một ít bản thảo"
	quest.3A597A26AAFD54B9.quest_desc: [
		"[{\"text\": \"Tìm hiểu danh vọng với người lùn\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"56413501A9E9D8FC\"}}]"
		""
		"Đạt mức danh vọng quy định để đi qua cánh cửa này đến phòng khiêu chiến thủ lĩnh người lùn."
	]
	quest.3A597A26AAFD54B9.quest_subtitle: "Công nghệ tiên tiến do người lùn chế tạo"
	quest.3A9101C87B524BD3.quest_desc: [
		"&6Bản Thiết Kế Ma Trượng"
		"(10 xu vàng) Đổi tại Pháp Sư Người Lùn cấp Đại Sư"
	]
	quest.3B5B1BFC34011F6C.quest_desc: [
		"Ra đời giữa khe hở &5tinh vân và hỗn mang&r, một vùng &bbiển hư vô&r bị lãng quên. &4Những mảnh ký ức vỡ vụn&r cùng khung cảnh đại lục xa lạ chập chờn trong ý thức..."
		" &8Ngươi không thuộc về nơi này, nhưng định mệnh đã giam ngươi tại đây&r"
	]
	quest.3B5B1BFC34011F6C.quest_subtitle: "Đây là đâu?"
	quest.3B5B1BFC34011F6C.title: "Lên đường"
	quest.3B60B1CC41276A5D.quest_subtitle: "Yếu hơn Giáp Kim Cương một chút"
	quest.3B60B1CC41276A5D.title: "Bộ giáp Ma Kiến"
	quest.3B9FAA9A2B1AE6A4.quest_desc: [
		"Có tỉ lệ 1% nhận từ rương trong Tháp Pháp Sư Đổ Nát."
		"&6Tiêu thụ 10 vật phẩm để mở quyền khoá kỹ năng Thời Gian Chi Vương.&r"
	]
	quest.3B9FAA9A2B1AE6A4.quest_subtitle: "Duy trì kỹ năng này"
	quest.3C348A1F46E6EDD3.quest_desc: ["Chúng ngủ ở tầng một và hai của pháo đài. Tiêu diệt để lấy Hạch Hư Không, dùng làm vũ khí hoặc dung hợp với trang bị khác tại Đe Dung Hợp Cơ Giới."]
	quest.3C348A1F46E6EDD3.quest_subtitle: "Kẻ canh giữ pháo đài"
	quest.3C348A1F46E6EDD3.title: "Đánh bại Ender Golem"
	quest.3C4D5E6F7A8B9012.title: "{translate:\"task.3C4D5E6F7A8B9013.title\"}"
	quest.3C5160A9C279B5A9.quest_desc: [
		"Để nhận Hạt Giống Ma Vương, trước tiên cần &6200.000&r EP và thuộc &5Ma Vật/Hỗn Mang&r"
		""
		"&lHạt Giống Ma Vương cho phép bạn:&r"
		"&6- Có tư cách thức tỉnh thành Ma Vương.&r"
		"&6- Mở khả năng thu thập linh hồn.&r"
	]
	quest.3C5160A9C279B5A9.quest_subtitle: "Hạt Giống Ma Vương là trạng thái cao cấp của ma vật. Linh hồn sinh linh đang hấp dẫn bạn."
	quest.3C5160A9C279B5A9.title: "&6【Con Đường Ma Vương】&rNhận Hạt Giống Ma Vương"
	quest.3D22913B4FB369F3.quest_subtitle: "Xác suất rơi"
	quest.3D3F898FE129112A.quest_desc: [
		"Công trình xuất hiện ở sa mạc, có thể tìm bằng Con Mắt Sa Mạc"
		"Bên trong có rất nhiều bẫy, hãy cẩn thận"
	]
	quest.3D3F898FE129112A.quest_subtitle: "Pharaoh Ai Cập thích thú cưng sao?"
	quest.3D3F898FE129112A.title: "Tìm Kim Tự Tháp Nguyền Rủa"
	quest.3D905AACA9BE52EC.quest_desc: "Xây nền 3×3 bằng Khối Ma Cương Thuần Khiết, đặt Khối Mithril ở giữa rồi nhấp chuột phải để triệu hồi Boss. &6Cảnh báo! Phải triệu hồi trong chiều không gian Con Đường."
	quest.3D905AACA9BE52EC.quest_subtitle: "Chỉ nên thử thách sau khi đánh bại Boss cuối của cốt truyện chính"
	quest.3D905AACA9BE52EC.title: "Xây bệ triệu hồi Boss Feldway"
	quest.3DAA0D096C085183.quest_subtitle: "[Nhấp để nộp nhiệm vụ sau khi nhận được tinh linh tương ứng]"
	quest.3DAA0D096C085183.title: "Thổ Tinh Linh · Trung Cấp"
	quest.3DE59F19B491EDC7.quest_desc: [
		"&6Kỹ năng Độc nhất đổi được sẽ tiêu hao Năng Lượng Linh Hồn khi sử dụng"
		"[{\"text\": \"Năng Lượng Linh Hồn\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"0FDA8DE439A0FC25\"}}]"
		""
		"&6Dùng Cuộn Đặt Lại Nhân Vật khi chưa khoá kỹ năng sẽ khiến chúng biến mất"
		"[{\"text\": \"Khoá kỹ năng\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"166F39FFE1C98A63\"}}]"
	]
	quest.3DE59F19B491EDC7.quest_subtitle: "Lưu ý"
	quest.3DE59F19B491EDC7.title: "Đổi Kỹ năng Độc nhất"
	quest.3EBFD5237BAC875A.quest_subtitle: "Nguyên liệu chế tạo"
	quest.3F92724DDA398BAB.quest_desc: [
		"&6Không thể trực tiếp giết [Nghiêm Phán]. Trong lượt phán [Tội Sát Sinh], hãy dụ \"Chim Phán Quyết\" vào bẫy trói, rồi dẫn Nghiêm Phán dùng [Tia Thanh Tẩy] giết chim để nó tự phạm tội. Mỗi lần như vậy, thanh máu Boss giảm 1. &6Sau 10 lần, nó sẽ chết."
		""
		""
		"\"Thanh máu\" thật của nó là số lần có thể phạm tội, ban đầu là 10. Mỗi lần phạm tội thành công, thanh máu giảm 1. Khi tổng số lần phạm tội đạt ít nhất 5, nó bước sang giai đoạn hai."
		""
		"Vì vậy, trận chiến này yêu cầu:"
		"Bày thế cờ để Boss tự phá luật."
		""
		"[Tội Sát Sinh] là lượt gây sát thương của bạn"
		"Trong lượt này, giết bất kỳ thực thể nào sẽ khiến kẻ giết nhận thêm 1 [Tội]"
		"Đây là lượt duy nhất khiến Nghiêm Phán mất máu."
		"Vì bạn có thể khiến nó giết Chim Phán Quyết"
		"Ưu tiên dẫn Chim Phán Quyết vào bẫy trói, giữ chim tại đó rồi chờ hoặc dụ Nghiêm Phán bắn Tia Thanh Tẩy"
	]
	quest.3F92724DDA398BAB.title: "Đánh bại Nghiêm Phán"
	quest.3F98657DFD336347.quest_desc: [
		"Trang bị gắn bó với bạn từ thuở đầu đã xuất hiện!"
		"&3Ma Cương Hạ Cấp (18k EP)->&r"
		"&bMa Cương Thượng Cấp (52k EP) ->&r"
		"&5Ma Cương Thuần Khiết (225k EP)->&r"
		"&dMa Cương Sinh Học (750k EP)&r-> &4Kim Loại Tối Thượng&r"
		""
		"Tương tự Da Ma Vật, chúng đều có thể tiến hoá."
	]
	quest.3F98657DFD336347.quest_subtitle: "Nghệ thuật trị liệu và rèn đúc"
	quest.3F98657DFD336347.title: "&6【Con Đường Rèn · Quan Trọng】&rTrang bị cho thật chuẩn!"
	quest.3FA83CA20E40D5F0.title: "{translate:\"task.FF6A7B8C9D0E1235.title\"}"
	quest.3FF9F50B6BD99394.quest_desc: [
		"Phản sát thương và đầu độc kẻ địch"
		"&6&lĐộc Dịch Hộ Vệ [Mở khoá Bách Khoa]"
		"{image:ablazeaqzlcz:textures/ftb/curios/thorn_pendant.png width:50 height:80 align:left}"
	]
	quest.3FF9F50B6BD99394.quest_subtitle: "Đừng chạm vào ta"
	quest.40AEB58A3D88CA54.quest_desc: [
		"Uống dược nhanh hơn"
		"&6&lUống Nhanh【Mở khoá Bách Khoa】"
		"{image:ablazeaqzlcz:textures/ftb/curios/plastic_drinking_hat.png width:50 height:80 align:left}"
	]
	quest.40AEB58A3D88CA54.quest_subtitle: "Uống cạn một hơi"
	quest.40B67AE14F3BEE69.quest_desc: ["&6Rơi từ Wither với tỉ lệ 20%.&r Khi sở hữu Azathoth, Hư Không Chi Thần, tiêu thụ 10 vật phẩm để khoá Kỹ năng Tối thượng trong menu “Khoá”, giúp giữ lại khi chuyển sinh."]
	quest.40B67AE14F3BEE69.quest_subtitle: "Giữ lại kỹ năng này"
	quest.413526DA9AF92A22.quest_desc: "Thông thạo Vô Hạn Lao Ngục rồi vào chế độ Hợp Nhất của Raphael. Giữ Shift + phím kỹ năng để chuyển sang [Có Thể Tiến Hoá], rồi nhấn phím kỹ năng để tiến hoá."
	quest.413526DA9AF92A22.quest_subtitle: "Điều kiện tiến hoá"
	quest.413526DA9AF92A22.title: "&6[Nâng Cao]&fKỹ năng Tối thượng Uriel, Thệ Ước Chi Vương"
	quest.413F740EE59BD0A1.quest_subtitle: "Xác định vị trí công trình"
	quest.41449735E77D4C2C.quest_desc: [
		"Cầm Bình Có Nút Bần nhấp chuột phải vào không khí để thu Ánh Nắng Đóng Chai. Càng thu nhiều, linh khí trong vùng càng giảm."
		""
		"&6Dùng ở Thế Giới Thường, Nether và The End sẽ lần lượt nhận Ánh Nắng Đóng Chai, U Hồn Đóng Chai và Bóng Tối Đóng Chai.&r"
	]
	quest.41449735E77D4C2C.quest_subtitle: "Chiếc bình chứa được ánh nắng?"
	quest.416FB00A97CBD910.quest_desc: [
		"&6EP mặc định: 2000"
		"&6Trang bị không thể tiến hoá"
	]
	quest.4179A079B1184ADA.title: "{translate:\"task.9C0D1E2F3A4B5679.title\"}"
	quest.4193D1D21332AB0E.quest_desc: ["Uống dược tàng hình rồi đến gần để trộm Tinh Thể Băng Giá. Bạn có thể trộm thành công, nhưng nó cũng sẽ thức dậy và nổi điên."]
	quest.4193D1D21332AB0E.quest_subtitle: "Lén lút thôi, đừng gây động tĩnh."
	quest.41BD09AC9E50B869.quest_desc: ["Xuất hiện ở Đồng Tuyết và Rừng Taiga Tuyết. Dùng dược tàng hình để trộm Tinh Thể Băng Giá trong tay nó, hoặc tiêu diệt nó để lấy."]
	quest.41BD09AC9E50B869.quest_subtitle: "Cự thú cánh đồng băng"
	quest.41E7CFE6CE6A85F1.quest_desc: ["Rơi từ Di Vật Cổ Đại, nhấp chuột phải để triệu hồi Di Vật Sống."]
	quest.41E7CFE6CE6A85F1.quest_subtitle: "Con trai của Cốt Long?"
	quest.4205403C9223C4B7.quest_desc: [
		"Như hình, nhấn B để mở bảng kỹ năng cá nhân, bạn sẽ thấy một số kỹ năng màu xám (trừ kỹ năng kháng tính)."
		"Nhấp vào kỹ năng muốn dùng/học rồi nhấp vào ô kỹ năng trên thanh phím tắt để gán. Cách thao tác giống hệt khi trang bị kỹ năng."
		""
		"Sau khi gán xong, nhấn các phím Z, X, C tương ứng để \"học\" kỹ năng."
		"Học xong, bạn vẫn dùng các phím đó để thi triển kỹ năng."
		"Một số kỹ năng đổi chế độ bằng ALT + phím kỹ năng hoặc Shift + phím kỹ năng tương ứng."
		"{image:ablazeaqzlcz:textures/ftb/skill.png width:150 height:150 align:center fit:true}"
	]
	quest.4205403C9223C4B7.quest_subtitle: "Không xem thì làm sao biết!"
	quest.42D4A8EEE5E25183.quest_desc: [
		"Bệ Đá Dịch Chuyển cho phép dịch chuyển tự do tới vị trí đã liên kết. Shift + chuột phải để liên kết, rồi dùng &5ma pháp \"Cổng Không Gian\"&r mở giao diện và chọn biểu tượng cổng."
		"{image:ablazeaqzlcz:textures/ftb/portal.png width:150 height:100 align:center}"
		"Muốn xoá điểm đã lưu, nhấp dấu chấm than rồi nhanh tay nhấp hai lần nút biểu tượng đỏ ở giữa."
	]
	quest.42D4A8EEE5E25183.quest_subtitle: "Đây là gì?"
	quest.42FCA469EA5C94D7.quest_desc: [
		"&#FFED54Liên kết:&r"
		"[{\"text\": \"Cách hoạt động của Cổ Vật\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"4DB740093C0BA804\"}}]"
		""
		"Hiệu ứng mặc định"
		"&5Hiệu ứng 1: Thế Đứng Bất Khuất"
		"Tăng 5 điểm Giáp và 25% Kháng Đẩy Lùi."
		"Hiệu ứng có tác dụng khi trang bị cổ vật và đã mở khoá hiệu ứng."
		""
		"Thưởng tinh luyện"
		"Mỗi lần tinh luyện tăng thêm 0,5 điểm Giáp."
		"Mỗi lần tinh luyện còn tăng thêm 5% Kháng Đẩy Lùi."
		"Tối đa: Ở mức tinh luyện +10, Thế Đứng Bất Khuất tăng 10 điểm Giáp và 75% Kháng Đẩy Lùi."
	]
	quest.42FCA469EA5C94D7.title: "&6【Cổ Vật】&fCổ Vật Viễn Cổ Bậc 3"
	quest.434C555DDB10A971.quest_subtitle: "[Chọn một tuyến, chơi đơn cũng có thể khiêu chiến tất cả]"
	quest.4387D3BF0F0AA32B.title: "{translate:\"task.D1E2F3A4B5C67891.title\"}"
	quest.440CA931DFF4AB39.quest_subtitle: "[Nhấp để nộp nhiệm vụ sau khi nhận được tinh linh tương ứng]"
	quest.440CA931DFF4AB39.title: "Phong Tinh Linh · Trung Cấp"
	quest.4454735A12F6DC87.quest_desc: [
		"Có thể tìm trong công trình kiểu Nhật ở Thế Giới Thường (Dân Làng Vẽ Bản Đồ cấp Đại Sư có cơ hội bán bản đồ), hoặc xuất hiện ngoài tự nhiên."
		""
		"&8Trung lập với mọi sinh vật trừ khi bị tấn công&r"
		"Đây là Rimuru thời giao chiến với Đại Quỷ Tộc, sở hữu hai Kỹ năng Độc nhất Kẻ Săn Mồi và Đại Hiền Giả."
		""
		"&lGiải thích các giai đoạn Boss:&r"
		""
		"&lGiai đoạn một&r"
		"&6-Có 20% cơ hội né đòn vật lý và dịch chuyển đến mục tiêu khi né."
		"&6-Có thể nuốt tên và các loại đạn khác."
		"&6-Kỹ năng: Thuỷ Nhận, Băng Thương, Tơ Đạn, Thổ Tức (ngẫu nhiên gây tê liệt/độc/hắc hoả)."
		"&6-Hồi 5 máu + 20 sinh lực linh hồn mỗi giây."
		"&6-Chuyển sang giai đoạn hai khi máu dưới 50% hoặc dưới 1000.&r"
		""
		"&lGiai đoạn hai (dạng giáp)&r"
		"&6-Khi bước vào giai đoạn này, Rimuru hồi đầy máu, sinh lực linh hồn và xoá mọi hiệu ứng bất lợi."
		"&6-Trang bị trọn bộ giáp Giáp Long và Găng Tay Giáp Long."
		"&6-Triệu hồi 4 phân thân trợ chiến (EP bằng 10% bản thể)."
		"&6-Tốc độ hồi phục bị động tăng lên 15 máu + 60 sinh lực linh hồn mỗi giây."
		"&6-Rimuru dùng toàn bộ kỹ năng giai đoạn một và thêm: Hắc Viêm Ngục, Hắc Lôi và Uy Áp."
	]
	quest.4454735A12F6DC87.quest_subtitle: "Ta muốn khiêu chiến ngươi"
	quest.4454735A12F6DC87.title: "Ngươi là Rimuru sao?"
	quest.4488E4793D485C08.quest_subtitle: "\"Ta\" khổng lồ"
	quest.4521C5CD54579EBA.quest_desc: ["Đặt lại mọi thứ của bạn về trạng thái ban đầu!"]
	quest.4521C5CD54579EBA.quest_subtitle: "Áp dụng cho “Bộ Đếm Đặt Lại”."
	quest.4547F61DCD2D7B57.quest_desc: [
		"&lTrời đất ơi!&r"
		""
		""
		"&lCách nhận:&r"
		"- Hầm mỏ bỏ hoang"
		"- Tàn tích Pháo Đài Piglin (chuồng Hoglin)"
		"- Đền Sa Mạc"
		"- Lều Tuyết"
		"- Cổng Dịch Chuyển Đổ Nát"
		"- Phòng có lồng sinh quái"
		"- Pháo Đài"
		"- Tàn Tích Dưới Biển (lớn)"
		"- Dinh Thự Rừng"
		"Có 50% xác suất xuất hiện ở những nơi này. &l(Số liệu chính thức)&r"
	]
	quest.4547F61DCD2D7B57.quest_subtitle: "Học các chiến kỹ Đấu Khí, trở thành bá chủ võ lâm?"
	quest.4547F61DCD2D7B57.title: "&6【Nhiệm Vụ Phụ · Cốt Lõi】&rBí kíp Đấu Khí"
	quest.46222BDACBBA4B70.title: "Zana Horowa"
	quest.465E337F99AEA94E.quest_desc: "Có cơ hội nhận khi đánh bại Hinata"
	quest.465E337F99AEA94E.quest_subtitle: "Điều kiện"
	quest.46F9C1A11397AF4E.quest_desc: [
		"Gán ma pháp đã học vào ma trượng và sách phép. &6(Chỉ gán được ma pháp nguyên tố như hoả, thuỷ, phong, thổ, không gian, trọng lực, lôi, âm ba và một số ma pháp triệu hồi)"
		""
		"&8Có thể tự chế tạo hoặc tìm trong tháp pháp sư và Vương Quốc Người Lùn ngoài tự nhiên."
	]
	quest.46FF849AF3C24F9E.quest_subtitle: "Thân thể nguyên vẹn, nguyên liệu luyện dược hoàn hảo"
	quest.47214EC2867A9B30.quest_desc: [
		"Ở Minh Giới, bạn có thể gặp một ác ma “đặc biệt”."
		"Khác những ác ma chỉ biết tàn sát, thôn phệ và tranh đấu, hắn lịch thiệp và điềm tĩnh lạ thường. Hắn hiếm khi tấn công kẻ yếu hay phô trương sức mạnh vô cớ. Nhưng khi ánh mắt hắn thật sự hướng về bạn, bạn sẽ hiểu: đây tuyệt đối không phải ác ma tầm thường. Dáng hình đen tuyền, Ma Tố sâu không lường và uy áp gây sợ hãi từ bản năng đều tiết lộ thân phận thật. Hắn là một trong những Ác Ma Thuỷ Tổ cổ xưa."
		"&c“Hắc Sắc”—Diablo.&r"
	]
	quest.47214EC2867A9B30.title: "&fĐánh bại &6【Diablo】"
	quest.47945DBEFB4C8D26.quest_subtitle: "【Thông Thạo】"
	quest.47945DBEFB4C8D26.title: "&6【Nâng Cao】&fSở hữu Kỹ năng Độc nhất Vô Hạn Lao Ngục"
	quest.47C041D061CC6669.quest_desc: ["Sau khi thuần phục sinh vật Tensura, nhấp chuột phải để trang bị yên này cho nó."]
	quest.47C041D061CC6669.quest_subtitle: "Trang bị cho \"Chiến Kỵ Sĩ\""
	quest.47DEE3D24B6F2A90.quest_subtitle: "Hấp thu rêu xung quanh và chuyển hoá thành linh khí"
	quest.48345B3536C27D98.quest_desc: [
		"Ngôi làng xây trên đầm lầy đước; cư dân thích môi trường ẩm ướt."
		"{image:ablazeaqzlcz:textures/ftb/lizardmen_village.png width:130 height:75 align:center}"
	]
	quest.48345B3536C27D98.quest_subtitle: "Nơi cư trú của Thằn Lằn Nhân"
	quest.48345B3536C27D98.title: "Bộ tộc đầm lầy"
	quest.4835EBAC6D933CDB.quest_desc: [
		"Rừng Cổ Đại là quần xã hiếm và nguy hiểm, nồng độ Ma Tố gấp 40 lần môi trường bình thường. &2&lNgười hái dược cũng sẽ vui mừng nhận ra Cỏ Hipokute ở đây nhiều hơn nơi khác một chút.&r"
		"{image:ablazeaqzlcz:textures/ftb/ancient_forest.png width:200 height:100 align:center}"
		"&6Lưu ý: Một số đại thụ ẩn giấu cổng mê cung trên những cành cây cao.&r"
		"Không phải Rừng Cổ Đại nào cũng có lối vào Mê Cung Tinh Linh. Bạn có thể phải tốn thời gian để tìm đúng cây mê cung!"
	]
	quest.4835EBAC6D933CDB.quest_subtitle: "Độ nguy hiểm cao; nếu EP dưới 8000 thì đừng đến!"
	quest.4835EBAC6D933CDB.title: "&6【Cốt Truyện Chính • Xứ Sở Tinh Linh】&rRừng Cổ Đại"
	quest.48653257AF7891C8.quest_desc: "&6Có thể tìm nơi này bằng toạ độ nhận được khi giao dịch với Người Canh Giữ Thời Gian"
	quest.48653257AF7891C8.quest_subtitle: "Tự sụp đổ"
	quest.4876462A04B3094B.quest_desc: ["&6Rơi từ Rimuru, Slime Siêu Khổng Lồ và Luminous. &rTiêu thụ để tăng tốc học kỹ năng trong 10 phút. Nếu sở hữu Đại Hiền Giả, Hiền Giả hoặc Trí Tuệ Chi Vương, bạn còn nhận độ thông thạo. Khi sở hữu Trí Tuệ Chi Vương hoặc Fortuna, Vận Mệnh Chi Vương, tiêu thụ 10 vật phẩm để khoá Kỹ năng Tối thượng trong màn hình “Khoá”, giúp giữ lại khi chuyển sinh."]
	quest.48849045FD239568.quest_desc: [
		"Có thể tìm trong rương ngoài tự nhiên và tháp pháp sư, hoặc tự chế tạo."
		"&8Vật phẩm nguyên liệu thuộc loại hiếm"
	]
	quest.48849045FD239568.quest_subtitle: "Nền tảng của ma cụ"
	quest.48C18EC1BD11BFFD.quest_desc: [
		"&8Tìm cạnh hoá thạch xương ở Nether."
		"Đào lên rồi ngâm nước khoảng 20 phút, nó sẽ biến thành tiểu tà linh. Cho ăn cầu tuyết để tăng tốc trưởng thành."
	]
	quest.48C18EC1BD11BFFD.quest_subtitle: "Ấp nở Nhạc Hồn"
	quest.48C51904019DBDE9.title: "Đánh bại Hoa Hư Không"
	quest.48EF9FC96BBC47AC.title: "Pháp Sư Quỷ Ăn Thịt Người"
	quest.4913736781F06A32.title: "{translate:\"task.D1E2F3A4B5C67891.title\"}"
	quest.49250178B975344D.quest_desc: [
		"&6Ma vật có thể sinh sản nhờ thức ăn! Cho hai ma vật đã thuần phục ăn đúng loại thức ăn để chúng sinh sản.&r"
		"Mọi thức ăn ăn được: Giáp Long, Hắc Chu, Nhện Giáp Chân Thương"
		""
		"Thịt, cá, mắt nhện, mắt nhện lên men, chân thỏ, thức ăn từ nấm đỏ hoặc nấm nâu: Ma Kiến Khổng Lồ"
		""
		"Thịt hoặc cá: Khuyển Ma, Xà Yêu Basilisk, Hổ Đơn Nhận, Nha Lang, Tà Ngô Công, Dơi Khổng Lồ, Cá Tuyết Khổng Lồ, Cá Hồi Khổng Lồ, Thằn Lằn Hút Máu, Sisi, Bò Sừng Thương, Bạo Phong Đại Xà"
		""
		"Cá: Thằn Lằn Lãng Du, Cá Trên Cạn, Cú Độc Nhãn"
		""
		"Hoa: Ong Quân Đoàn"
		""
		"Cà rốt, cà rốt vàng, bồ công anh và thức ăn tương tự: Thỏ Một Sừng"
		""
		"Thức ăn từ Hipokute: Hươu Bò, Thiên Mã, Kỳ Lân"
		""
		"Thịt, cá hoặc thức ăn từ thịt Hươu Bò: Gấu Khổng Lồ, Gấu Có Sừng"
		""
		"Thức ăn từ củ dền, táo, khoai tây, cà rốt: Long Khổng Tước"
		""
		"Len: Bướm Đêm Địa Ngục"
		""
		"&6Một số ma vật rất hiếm, nuôi và cho chúng sinh sản là lựa chọn tuyệt vời!&r"
	]
	quest.49250178B975344D.quest_subtitle: "Bạn có biết?"
	quest.497719F98AB65C4E.quest_desc: [
		"Hắn đứng cạnh Cổng Tinh Quang, nhấp chuột phải để trò chuyện."
		"&6Tàn tích cổng có thể xuất hiện ở mọi nhóm quần xã. Thử nhìn bản đồ xem?&r"
		""
		"{image:ablazeaqzlcz:textures/ftb/eternal_starlight/portal_ruins.png width:170 height:100 align:center}"
	]
	quest.497719F98AB65C4E.quest_subtitle: "Vừa là Boss vừa là thương nhân?"
	quest.49DBFDBAF97C1BC7.quest_subtitle: "Sao chỉ có ba cái đầu?"
	quest.4A6D37AACDB09FA2.quest_desc: ["Vượt 10.000 EP, bạn có thể khám phá 99% khu vực và mở khoá các kỹ năng mạnh hơn để trang bị cho bản thân."]
	quest.4A6D37AACDB09FA2.title: "&6【Cốt Truyện Chính】&rĐạt 10.000 EP"
	quest.4A98230B150A9D9A.quest_desc: "Xây khung cổng tương tự cổng Nether, chế tạo \"Đồng Hồ Cát Thời Gian\" rồi nhấp chuột phải vào cổng để kích hoạt và đi vào chiều không gian"
	quest.4A98230B150A9D9A.quest_subtitle: "Thế giới đông cứng vĩnh hằng"
	quest.4A98230B150A9D9A.title: "Xây khung cổng"
	quest.4AAF730F2A6A96E2.quest_desc: [
		"&6EP mặc định: 0"
		"&6Đạt 6000 EP để tiến hoá thành Mũ Ma Cương Hạ Cấp."
	]
	quest.4AAF730F2A6A96E2.quest_subtitle: "Mũ có sừng"
	quest.4B0217A8DB07F15F.quest_desc: ["Bên trong có nhiều mạch phun biến đổi vật phẩm, chẳng hạn biến sọ thành Sọ Wither. Xem JEI để biết chi tiết."]
	quest.4B0217A8DB07F15F.quest_subtitle: "Đáy biển sâu đến đâu"
	quest.4B0217A8DB07F15F.title: "Đến Vực Thẳm"
	quest.4B75015F91F5714D.quest_desc: ["Ngục tốt trông coi những tên tội phạm hung ác nhất; gặp hắn là may mắn đấy"]
	quest.4B75015F91F5714D.quest_subtitle: "Là giám ngục sao?"
	quest.4B75015F91F5714D.title: "Ngục tốt"
	quest.4B7649B9A42AEBEE.quest_desc: [
		"Có thể tìm ở thảo nguyên; tấn công người chơi không đeo mặt nạ. &6Phúc Lành Mặt Trời"
		""
		"{image:ablazeaqzlcz:textures/ftb/adventure/umvuthi_home.png width:170 height:100 align:center}"
	]
	quest.4B7649B9A42AEBEE.quest_subtitle: "Bộ tộc thảo nguyên"
	quest.4BA9724587B4D6FE.quest_subtitle: "Nguyên liệu chế tạo trang bị cao cấp"
	quest.4BA9724587B4D6FE.title: "Vật phẩm rơi sau khi đánh bại Hoả Ma"
	quest.4BC9A690FBB9F423.quest_desc: [
		"Trên đỉnh tháp Vệ Thành có một chiếc neo ở giữa. Nhấp chuột phải để triệu hồi Scylla, nhưng hãy cẩn thận trước khi chạm vào."
		"&6Sở hữu Vô Hiệu Ăn Mòn, Vô Hiệu Trạng Thái Bất Thường, Cường Hoá Cơ Thể và Cường Hoá Cương Thép."
		""
		"Cô ta có ba giai đoạn, mỗi lần mất một phần ba máu sẽ chuyển sang giai đoạn tiếp theo."
	]
	quest.4BC9A690FBB9F423.quest_subtitle: "Người phụ nữ cầm neo"
	quest.4BC9A690FBB9F423.title: "Đánh bại Hải Yêu Scylla"
	quest.4C02AA6C31E0ECC6.quest_subtitle: "Đảo nổi ở The End"
	quest.4CAB0E1CE150DBD9.quest_desc: "Vật phẩm rơi khi tiêu diệt Orc Tai Hoạ hoặc Orc Chúa"
	quest.4CAB0E1CE150DBD9.quest_subtitle: "Bảo vật của tộc Orc"
	quest.4D396C80A4183219.quest_desc: ["&7Từ lâu ta đã nghe nói có một di tích bí ẩn ẩn sâu trong thành phố cổ dưới lòng đất."]
	quest.4D396C80A4183219.quest_subtitle: "Di tích trong thành phố cổ"
	quest.4D396C80A4183219.title: "Tìm kiếm \"Vực Thẳm\""
	quest.4D5E6F7A8B9C0123.title: "{translate:\"task.4D5E6F7A8B9C0124.title\"}"
	quest.4D66FADBC0A3FB2E.quest_desc: [
		"Cách nhận: Thông thạo Cảm Tri Ma Lực + Cảm Tri Nhiệt Nguyên + Cảm Tri Âm Ba"
		""
		"&l[Bị động - Bật/Tắt]:&r"
		"Kết hợp hiệu quả của Cảm Tri Ma Lực, Cảm Tri Nhiệt Nguyên và Cảm Tri Âm Ba."
	]
	quest.4D66FADBC0A3FB2E.title: "&6【Mẹo】&rSở hữu và thông thạo 【Vạn Năng Cảm Tri】"
	quest.4DB740093C0BA804.quest_desc: [
		"Mỗi cổ vật có bậc, ô trang bị, ngưỡng EP và một hoặc nhiều hiệu ứng. Khi đạt ngưỡng EP yêu cầu, hiệu ứng tương ứng sẽ kích hoạt. Cổ vật có số bậc lớn hơn thường đơn giản hơn và mở ít hiệu ứng hơn. Cổ vật Bậc 1 có lộ trình phát triển dài nhất, mở được tối đa ba hiệu ứng."
		""
		"Bậc cổ vật và lộ trình phát triển"
		"Cổ vật chia làm ba bậc. Mỗi bậc quyết định EP ban đầu, điều kiện mở hiệu ứng và giới hạn tinh luyện."
		"&6Cổ vật Bậc 3"
		"- Khởi đầu ở 52.000 EP"
		"- Mở hiệu ứng ở 52.000 EP"
		"- Tinh luyện tối đa 10 lần"
		""
		"&6Cổ vật Bậc 2"
		"- Khởi đầu ở 52.000 EP"
		"- Mở hiệu ứng đầu ở 52.000 EP"
		"- Mở hiệu ứng thứ hai ở 225.000 EP"
		"- Tinh luyện tối đa 5 lần"
		""
		"&6Cổ vật Bậc 1"
		"- Khởi đầu ở 225.000 EP"
		"- Mở hiệu ứng đầu ở 225.000 EP"
		"- Mở hiệu ứng thứ hai ở 1.000.000 EP"
		"- Mở hiệu ứng thứ ba ở 5.000.000 EP"
		"- Một số hiệu ứng cuối còn yêu cầu Kỹ năng Độc nhất hoặc điều kiện phù hợp"
		"- Tinh luyện tối đa 3 lần"
		""
		"{@pagebreak}"
		"Nâng cấp cổ vật bằng cách ghép hai cổ vật giống nhau trên đe."
		"Cổ vật chính phải tiến hoá đủ mức để đáp ứng điều kiện nâng cấp."
		"&6- Cổ vật Bậc 3 nâng cấp được sau khi đạt 52.000 EP"
		"&6- Cổ vật Bậc 2 tinh luyện được sau khi đạt 225.000 EP"
		"&6- Cổ vật Bậc 1 tinh luyện được sau khi đạt 5.000.000 EP"
		"Tinh luyện tăng sức mạnh hiệu ứng cổ vật. Trong hệ thống hiện tại, mỗi lần tinh luyện được phân ngẫu nhiên cho một hiệu ứng hợp lệ."
		"Một số hiệu ứng có giới hạn tinh luyện riêng. Khi đạt giới hạn, các lần tinh luyện sau được phân cho hiệu ứng hợp lệ khác."
	]
	quest.4DC96C29B2067A37.quest_desc: [
		"Giảm nguy cơ bị thiêu chết"
		"&6&lKháng Nhiệt [Mở khoá Bách Khoa]"
		"{image:ablazeaqzlcz:textures/ftb/curios/obsidian_skull.png width:50 height:80 align:left}"
	]
