	quest.52618536396B39A0.quest_desc: [
		"Cách nhận"
		"Trở thành Anh Hùng hoặc Ma Vương"
		""
		"&l[Khi nhấn]&r"
		"Tiêu hao 1.000 Ma Tố để biến thành hình dạng có kích thước con người. Khi chết sẽ trở lại kích thước ban đầu."
	]
	quest.52618536396B39A0.quest_subtitle: "Luôn duy trì kích thước con người"
	quest.52618536396B39A0.title: "&6[Nâng Cao]&fSở hữu kỹ năng Nhân Hoá"
	quest.527C27144046597D.title: "Dùng chế tạo các loại bệ dịch chuyển"
	quest.52A30DD2FEEEAB9B.quest_desc: [
		"Hấp thu linh khí xung quanh để thay đổi thời gian."
		""
		"Đặt Nhật Quỹ Chuyển Thời xuống đất, gắn Khung Vật Phẩm lên đó rồi đặt Kim Thời Gian vào khung. Nhấp chuột phải xoay tới thời điểm mong muốn, sau đó thả một chiếc Đồng Hồ trước khối."
	]
	quest.52A30DD2FEEEAB9B.quest_subtitle: "Năng lực thay đổi thời gian"
	quest.52BB3788E78BDEC5.title: "&#FF6854【Thu Hồi】&fSách Hướng Dẫn Chiến Ý"
	quest.52E122FDA87AFC22.quest_desc: [
		"Thức dậy khi người chơi đến gần. Có hai giai đoạn; ở giai đoạn hai mở Hư Không Chấn và Nhảy Chấn Địa, đồng thời cường hoá kỹ năng giai đoạn đầu."
		"&6Kỹ năng sở hữu: Vô Hiệu Công Kích Không Gian, Vô Hiệu Công Kích Trọng Lực, Vô Hiệu Trạng Thái Bất Thường và Cường Hoá Cơ Thể."
	]
	quest.52E122FDA87AFC22.quest_subtitle: "Kẻ canh giữ boong-ke"
	quest.52E122FDA87AFC22.title: "Đánh bại Ender Guard"
