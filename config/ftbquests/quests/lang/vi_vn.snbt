	quest.28B912AFF70B40C7.title: "Thu thập xương rồng"
	quest.2936183B86B29BD1.quest_desc: [
		"&4&lHoả Long: Ấp trong lửa"
		"&b&lBăng Long: Đặt trong nước để ấp"
