	quest.6190955DF040A782.title: "&6[Nâng Cao]&fSở hữu Kỹ năng Độc nhất Biến Chất Giả"
	quest.61A6D0A00AC7F345.title: "Taratect"
	quest.61D5F38862A9CCFB.quest_desc: [
		"&6Có cơ hội rơi ra khi tiêu diệt ma vật.&r"
		"Có thể hấp thu bằng kỹ năng \"&bHấp Thu & Phân Giải&r\"."
		""
		"Nguyên liệu cần để chế tạo Bình Ma Thuỷ, đồng thời là một thành phần điều chế Dược Hồi Phục Ma Lực."
	]
	quest.61D5F38862A9CCFB.quest_subtitle: "Nguyên liệu quý hiếm"
	quest.61D5F38862A9CCFB.title: "&6【Nguyên Liệu Cơ Bản】Ma Tinh Thạch Cao Cấp"
	quest.637C7FB48DE99548.quest_desc: ["Có thể tìm bằng Sao Linh Hồn."]
	quest.637C7FB48DE99548.quest_subtitle: "Tháp đổ nát phủ băng tuyết"
	quest.637D5A89578A13C8.quest_desc: "Có thể đổi bản đồ di tích với họ. Nên đổi bản đồ Tháp Đồng Hồ Sa Mạc trước"
	quest.637D5A89578A13C8.quest_subtitle: "Cư dân bản địa"
	quest.63D9D242CC572509.title: "{translate:\"task.8B9C0D1E2F3A4568.title\"}"
	quest.640D2E31AC98288A.quest_desc: [
		"Shift + chuột phải: Triệu hồi \"sóng thần nhỏ\""
		"Chuột phải thường: Phóng neo tấn công kẻ địch"
		"&6EP mặc định: 0"
		"&6Tiêu diệt sinh vật có thể tăng EP, nhưng vũ khí không thể tiến hoá."
	]
	quest.640D2E31AC98288A.quest_subtitle: "Thả neo vào kẻ địch"
	quest.646AD8F08500C517.quest_subtitle: "Tiêu diệt mà không nhận sát thương."
	quest.6477051F3EB3AC02.title: "&#FF6854【Thu Hồi】&fDược Bí Thuật Cao Cấp"
	quest.64CFB0D7AF7E85A5.title: "【Sứ Giả Bạc】Món khoái khẩu của Goblin?"
	quest.64F8DC0AD541359A.quest_desc: [
		"&8Tháp Đồng Hồ Sa Mạc trở thành tuyến phong toả đầu tiên. Thợ đồng hồ giao chìa khoá mê cung cuối cho vệ binh mạnh nhất, ra lệnh vĩnh viễn trấn giữ tầng năm. Từng chỉ là kỵ sĩ cơ giới bảo vệ học giả, nhưng dưới sự bào mòn của thời gian, nó dần quên chủ nhân..."
		""
		"Leo lên đỉnh rồi nhấp chuột phải vào Bộ Dịch Chuyển Tháp Đồng Hồ để vào phòng Boss. Đừng di chuyển khi đang dịch chuyển, nếu không sẽ thất bại"
	]
	quest.64F8DC0AD541359A.quest_subtitle: "Đánh bại Boss đầu tiên"
	quest.650CEA57092B481D.quest_subtitle: "Tiến hoá từ Mặt Nạ Bạo Chúa"
	quest.6533548BC66DB5E7.quest_desc: [
		"Hoàn thành mọi nhiệm vụ của Bộ Đếm Đặt Lại, rồi dùng Cuộn Đặt Lại Nhân Vật để chuyển sinh hoàn hảo, nhận 20 Điểm Linh Hồn và một Kỹ năng Độc nhất mới."
		"&4Cảnh báo: Phải hoàn thành mọi yêu cầu của Bộ Đếm Đặt Lại trước khi dùng Cuộn Đặt Lại Nhân Vật, nếu không sẽ không nhận Điểm Linh Hồn hay Kỹ năng Độc nhất mới."
		"&4Cuộn Đặt Lại Nhân Vật đặt lại chủng tộc, kỹ năng, tiến trình thành tựu và các tiến trình nhân vật khác. Vật phẩm không biến mất!"
		""
		"&6Nội dung liên quan:&r"
		"[{\"text\": \"Giới thiệu Tinh Hoa Chuyển Sinh và Bộ Đếm Đặt Lại\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"2E0D203C4166C35C\"}}]"
		"[{\"text\": \"Giới thiệu chức năng Khoá Kỹ Năng\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"166F39FFE1C98A63\"}}]"
	]
	quest.6533548BC66DB5E7.quest_subtitle: "Chuyển sinh, trở thành tồn tại cao hơn"
	quest.6533548BC66DB5E7.title: "Hoàn thành nhiệm vụ Bộ Đếm Đặt Lại"
	quest.654862122A3AD920.quest_desc: ["Nhấp chuột phải để triệu hồi một luồng bão cát"]
	quest.654862122A3AD920.quest_subtitle: "Bão cát nhỏ"
	quest.658BA859C44C25BF.quest_desc: [
		"Có thể tìm trong lâu đài ở Thế Giới Thường (Dân Làng Vẽ Bản Đồ cấp Đại Sư có cơ hội bán bản đồ), hoặc xuất hiện ngoài tự nhiên."
		""
		"&8Thù địch với sinh vật có hơn 10.000 EP&r"
		"Nếu chưa có kỹ năng hoặc ma pháp mạnh, đừng thử khiêu chiến cô ấy!"
		""
		"&lGiải thích các giai đoạn Boss:&r"
		""
		"&lGiai đoạn một&r"
		"&6-Dùng chiến kỹ cơ bản và đòn công kích ma pháp."
		"&6-Có 12,5% cơ hội né và có thể dịch chuyển khi bị tấn công."
		"&6-Kỹ năng: Trói Bóng, Huyết Nhận Thiểm Hồng Ba, Thao Túng Tâm Trí, Vòng Tay Sinh Tử, Phúc Lành Tử Vong."
		"&6-Hồi 10 máu + 50 sinh lực linh hồn mỗi giây."
		"&6-Chuyển sang giai đoạn hai khi máu dưới 50% hoặc Ma Tố dưới 50%.&r"
		""
		"&lGiai đoạn hai (hình thái cuối)&r"
		"&6-Khi vào giai đoạn này, Luminous hồi đầy máu, Ma Tố và xoá mọi hiệu ứng bất lợi."
		"&6-Trang bị vũ khí: Dạ Hồng Vi."
		"&6-Xác suất né tăng lên 25%."
		"&6-Tốc độ hồi phục bị động tăng lên 20 máu + 100 sinh lực linh hồn mỗi giây."
		"&6-Luminous dùng toàn bộ kỹ năng giai đoạn một và thi triển thêm \"Băng Hoại Nguyên Tử\":"
		"&6-Trong lúc niệm, tốc độ di chuyển mục tiêu bị giảm mạnh."
		"&6-Cần gây đủ sát thương lên cô ấy để ngắt kỹ năng."
		"&6-Nếu \"Băng Hoại Nguyên Tử\" đánh trúng, mục tiêu chết ngay lập tức."
	]
