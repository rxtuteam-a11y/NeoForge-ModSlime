	quest.744E572AD1BF9FD6.quest_subtitle: "Các công trình đổ nát trong chiều không gian Nether"
	quest.746A6D4AD0F5086F.quest_subtitle: "Thử thách ư?"
	quest.746A6D4AD0F5086F.title: "Vượt thử thách của Nhà Điêu Khắc - Bậc Thầy Cánh Tay"
	quest.74C1BF247D821009.quest_desc: ["&8Có thể tìm thấy nhiều ma pháp và ma cụ kỳ lạ bên trong."]
	quest.74C1BF247D821009.quest_subtitle: "Ngọn tháp dựng trên cánh đồng băng"
	quest.74F615E1EE2FC750.quest_desc: [
		"Ném khoáng sản thô vừa đào vào để phân giải và sàng lọc, không tiêu hao nhiên liệu."
		"&6Ví dụ, 64 Mảnh Ma Khoáng có thể sàng được 102 mảnh, nhiều hơn 38 mảnh."
	]
	quest.74F615E1EE2FC750.quest_subtitle: "Một hoá ba"
	quest.74F615E1EE2FC750.title: "&6【Con Đường Rèn · Bổ Sung】&rMáy sàng tự động hoàn toàn?"
	quest.7520ACD27D831180.quest_subtitle: "[Nhấp để nộp nhiệm vụ sau khi nhận được tinh linh tương ứng]"
	quest.7520ACD27D831180.title: "Hoả Tinh Linh · Trung Cấp"
	quest.7536532A088C6144.quest_subtitle: "Dùng bông hoa này để định vị ma vật đó."
	quest.7536532A088C6144.title: "Tìm \"Hoa Ăn Thịt\""
	quest.7621D7B84C9D710F.quest_desc: [
		"Đặt Sách Chưa Gán Phép vào Bàn Gán Ma Pháp, rồi chọn ma pháp đã thông thạo để hoàn tất."
		""
		"Cách nhận: Có 1% cơ hội tìm trong rương của thầy dạy ma pháp người lùn, hoặc 5%–10% trong tháp pháp sư."
	]
	quest.7621D7B84C9D710F.quest_subtitle: "Vật trung gian thi triển ma pháp hiếm"
	quest.7699A815D2FAA05D.quest_desc: ["Các loại Linh Than có thể giảm thời gian luyện đan. **Vô Thượng Đan Kinh** cũng là kỹ năng giảm thời gian luyện đan; học xong thì nhấn phím kỹ năng để kích hoạt."]
	quest.7699A815D2FAA05D.quest_subtitle: "Đây là ma cụ dùng để luyện đan dược."
	quest.76CF8528AD72AE60.quest_desc: ["Cần ít nhất 1 thỏi sắt + 4 Mảnh Ma Khoáng để luyện một Thỏi Ma Cương Hạ Cấp, nên phải đào rất nhiều Ma Khoáng!"]
	quest.76CF8528AD72AE60.quest_subtitle: "Tạo kim loại mạnh nhất..."
	quest.76CF8528AD72AE60.title: "&6【Con Đường Rèn · Quan Trọng】&rThỏi sắt thấm Ma Tố"
	quest.76D0AE3CA0CEC97B.quest_desc: ["&8Có thể tìm thấy nhiều ma pháp và ma cụ kỳ lạ bên trong."]
	quest.76D0AE3CA0CEC97B.quest_subtitle: "Ngọn tháp trong rừng"
	quest.76E9B499018DF134.title: "&6【Cốt Truyện Chính】&rĐạt 1,2 triệu EP"
	quest.7701D3E35582F91A.quest_desc: ["Pháo đài trên đảo ngoài của The End, có thể tìm bằng Con Mắt Hư Không."]
	quest.7701D3E35582F91A.quest_subtitle: "Công trình biệt lập"
	quest.7701D3E35582F91A.title: "Đến Pháo Đài Bỏ Hoang"
	quest.77209E7CA9027AA4.quest_desc: [
		"&6Lưu ý: Không dùng kỹ năng khi đang chạy hoạt cảnh, vì có thể làm trống các ô kỹ năng đã gán."
		""
		"Xuất hiện ở núi tuyết, quanh Boss có những bộ hài cốt đóng băng."
	]
	quest.77209E7CA9027AA4.quest_subtitle: "Dã nhân đông cứng nơi núi tuyết"
	quest.77224F3957EF8057.quest_desc: [
		"Có hai cách đến Linh Giới. Một là chuyển sinh thành Tinh Linh Tộc, khi đó điểm hồi sinh của bạn sẽ ở thế giới này!"
		"Linh Giới có nhiều sinh vật tinh linh, một số tò mò và thân thiện với bạn, số khác thì thù địch."
		""
		"Vậy quay về thế giới chính thế nào?"
		""
		"&6Chuyển sinh thành Tinh Linh Tộc rồi muốn về thế giới chính sẽ cần thêm điều kiện!"
	]
	quest.77224F3957EF8057.quest_subtitle: "Giải thích"
	quest.77224F3957EF8057.title: "Chào mừng đến Linh Giới!"
	quest.774C400118E08DB2.title: "Tướng Quân Quỷ Ăn Thịt Người"
	quest.7758E6431EFDF6A6.quest_desc: [
		"Muốn về thế giới chính hoặc đến Minh Giới, bạn phải đi qua cánh cửa này."
		""
		"{image:ablazeaqzlcz:textures/ftb/hell_gate.png width:100 height:100 align:center}"
	]
	quest.7758E6431EFDF6A6.quest_subtitle: "Nơi quái quỷ nào đây?"
	quest.77681E6F6ECDDA97.quest_desc: [
