	quest.03794AB92667475D.title: "&6【Nâng Cao】&fKỹ năng Tối thượng Thần Tướng Mahoraga"
	quest.03A5439769F82AAC.quest_desc: ["Có một căn phòng bí mật giữa hai thác dung nham, bên dưới bệ đặt Quái Vật Netherite. Bên trong có một Quái Vật Netherite Con, có thể đánh thức bằng cách cho ăn pin."]
	quest.03A5439769F82AAC.quest_subtitle: "\"Pin Năng Lượng Hạt Nhân\""
	quest.03A5439769F82AAC.title: "Một ít pin"
	quest.040A52B895B14119.quest_subtitle: "[Nhấp để nộp nhiệm vụ sau khi nhận được tinh linh tương ứng]"
	quest.040A52B895B14119.title: "Thổ Tinh Linh · Hạ Cấp"
	quest.043E80CA9C59B5FB.quest_subtitle: "【Thông Thạo】"
	quest.043E80CA9C59B5FB.title: "&6【Nâng Cao】&fSở hữu Kỹ năng Độc nhất Albis Vina"
	quest.04AB969794B55A42.quest_desc: ["&6Rơi từ Rimuru, Slime Siêu Khổng Lồ và Luminous. &rTiêu thụ để tăng tốc học kỹ năng trong 10 phút. Nếu sở hữu Đại Hiền Giả, Hiền Giả, Trí Tuệ Chi Vương hoặc Fortuna, Vận Mệnh Chi Vương, bạn còn nhận thêm độ thông thạo. Khi sở hữu Fortuna, tiêu thụ 10 vật phẩm để khoá Kỹ năng Tối thượng trong màn hình “Khoá”, giúp giữ lại kỹ năng khi chuyển sinh."]
	quest.04AB969794B55A42.quest_subtitle: "Duy trì kỹ năng này"
	quest.04E5980B07480666.quest_subtitle: "Rơi từ Scylla"
	quest.04E5980B07480666.title: "Tinh Hoa Bão Tố"
	quest.0500D8F45231086A.quest_desc: "&6Có tỉ lệ 1% rơi từ sinh vật trong trạng thái \"Cuồng Bạo\".&r Khi sở hữu Satanael, Phẫn Nộ Chi Vương, tiêu thụ 10 vật phẩm để khoá Kỹ năng Tối thượng trong màn hình \"Khoá\", giúp giữ lại kỹ năng khi chuyển sinh."
	quest.0500D8F45231086A.quest_subtitle: "Giữ lại kỹ năng"
	quest.057552A8551732B6.quest_desc: [
		"1. Thông thạo Kỹ năng Độc nhất Albis Vina."
		"2. Lượng Ma Tố tối đa vượt 850.000."
	]
	quest.057552A8551732B6.quest_subtitle: "Điều kiện↓"
	quest.057552A8551732B6.title: "&6【Nâng Cao】&fKỹ năng Tối thượng Elfaria, Thánh Khiết Băng Cơ"
	quest.057EDB04B54A28DF.quest_desc: [
		"Đánh bại nó rất đơn giản, chỉ cần phá các khối năng lượng!"
		"Bạn cũng có thể khống chế nó bằng Lọ Hàn Băng. Mỗi lần Khôi Lỗi Tinh Quang trúng một lọ ném ra, năng lượng của nó giảm 3 điểm."
	]
	quest.057EDB04B54A28DF.quest_subtitle: "Ổn chứ, anh bạn to xác?"
	quest.057EDB04B54A28DF.title: "Động đậy đi nào!"
	quest.05966C3C01F23D2A.quest_desc: "&6Rơi từ Rimuru, Slime Siêu Khổng Lồ và Luminous. &rTiêu thụ để tăng tốc học kỹ năng trong 10 phút. Nếu sở hữu Đại Hiền Giả, Hiền Giả hoặc Trí Tuệ Chi Vương, bạn còn nhận thêm độ thông thạo. Khi sở hữu Trí Tuệ Chi Vương, tiêu thụ 10 vật phẩm để khoá Kỹ năng Tối thượng trong màn hình \"Khoá\", giúp giữ lại kỹ năng khi chuyển sinh."
	quest.05966C3C01F23D2A.quest_subtitle: "Bảo lưu kỹ năng này"
	quest.068F19A731087BC0.quest_desc: ["Tiến hoá thành trượng trung cấp khi đạt 18.000 EP."]
	quest.06D1B9E52BAEA193.quest_desc: [
		"&6Có cơ hội rơi ra khi tiêu diệt ma vật.&r"
		"Có thể hấp thu bằng kỹ năng \"&bHấp Thu & Phân Giải&r\"."
		"Nguyên liệu cần để chế tạo Bình Ma Thuỷ, đồng thời là một thành phần điều chế Dược Hồi Phục Ma Lực."
	]
	quest.06D1B9E52BAEA193.quest_subtitle: "Nguyên liệu thông dụng"
	quest.06D1B9E52BAEA193.title: "&6【Nguyên Liệu Cơ Bản】Ma Tinh Thạch"
	quest.06D9CFEA57AC9827.quest_desc: [
		"&#FFED54Liên kết:&r"
		"[{\"text\": \"Cách hoạt động của Cổ Vật\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"4DB740093C0BA804\"}}]"
		""
		"Hiệu ứng mặc định"
		"&5Hiệu ứng 1: Ngự Phong Hành"
		"Tăng tốc độ bay 15%."
		"Hiệu ứng có tác dụng khi trang bị cổ vật và đã mở khoá hiệu ứng."
		"&5Hiệu ứng 2: Phong Chi Bá Chủ"
		"Tăng sát thương Phong 25%."
		"Hiệu ứng có tác dụng khi trang bị cổ vật và đã mở khoá hiệu ứng."
		""
		"Thưởng tinh luyện"
		"Tăng trưởng Ngự Phong Hành"
		"Mỗi lần tinh luyện dành cho Ngự Phong Hành tăng thêm 5% tốc độ bay."
		"Tối đa: Ở mức tinh luyện +5, Ngự Phong Hành tăng tối đa 40% tốc độ bay."
		"Tăng trưởng Phong Chi Bá Chủ"
		"Mỗi lần tinh luyện dành cho Phong Chi Bá Chủ tăng thêm 5% sát thương Phong."
		"Tối đa: Ở mức tinh luyện +5, Phong Chi Bá Chủ tăng tối đa 50% sát thương Phong."
	]
	quest.06D9CFEA57AC9827.title: "&6【Cổ Vật】&fCổ Vật Viễn Cổ Bậc 2"
	quest.06EAE9E79B48163A.quest_desc: [
		"Khiến người chơi hoàn toàn vô hình, không có hiệu ứng hạt; một số ma vật sẽ không phát hiện ra bạn."
		"&6&lBước Chân Vô Thanh【Mở khoá Bách Khoa】"
		"{image:ablazeaqzlcz:textures/ftb/curios/scarf_of_invisibility.png width:50 height:80 align:left}"
	]
	quest.06EAE9E79B48163A.quest_subtitle: "Không thấy ta đâu!"
	quest.06F901B9C0674A9E.quest_desc: ["Hồi 100 MP sau khi uống"]
	quest.06F901B9C0674A9E.quest_subtitle: "Ma thuỷ chưa sôi, cỏ còn chưa lớn"
	quest.0717E965DDDDF44C.quest_desc: "&6Có thể tìm nơi này bằng toạ độ nhận được khi giao dịch với Người Canh Giữ Thời Gian"
	quest.0717E965DDDDF44C.quest_subtitle: "Ký ức thất lạc trong khe nứt thời gian"
	quest.071982156982C088.title: "{translate:\"task.FF6A7B8C9D0E1235.title\"}"
	quest.07529A000076D20F.quest_subtitle: "Linh thú xuất hiện ở Rừng Taiga, Rừng Anh Đào hoặc Rừng Sồi Sẫm"
	quest.07529A000076D20F.title: "Almiraj ư?"
	quest.0755AAA36D9BB609.quest_desc: ["[{\"text\": \"Yêu cầu: Nhiệm vụ Bản Thảo\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"3A3E98E35AA1FDAA\"}}]"]
	quest.0755AAA36D9BB609.quest_subtitle: "Chép nội dung bản thảo vào Bách Khoa Ma Vật"
	quest.078B1E365E595290.quest_desc: [
		"Tìm Bia Mộ Nguyền Rủa sâu trong mê cung, nhấp chuột phải để triệu hồi Di Hài Có Cánh Bị Nguyền"
		""
		"&6Kỹ năng của nó gồm Vô Hiệu Lạnh, Kháng Công Kích Vật Lý, Vô Hiệu Đau Đớn, Kháng Công Kích Thần Thánh, Vô Hiệu Độc, Kháng Trạng Thái Bất Thường và Kháng Công Kích Tinh Thần."
	]
	quest.078B1E365E595290.quest_subtitle: "Biển cả đổi thay"
	quest.078B1E365E595290.title: "Thảo phạt Di Hài Có Cánh Bị Nguyền"
	quest.07BCD842AEA4A0C4.title: "{translate:\"task.AA1B2C3D4E5F6780.title\"}"
	quest.07D69899C52591E9.quest_desc: [
		"Có ba giai đoạn. Mỗi khi mất một phần ba lượng máu, nó sẽ bước sang giai đoạn tiếp theo."
		"&6Kỹ năng của nó gồm Vô Hiệu Công Kích Hoả, Vô Hiệu Nhiệt, Vô Hiệu Trạng Thái Bất Thường, Cường Hoá Cơ Thể và Cương Lực."
		""
		"Sau khi đánh bại nó, Cuồng Hồn Rực Cháy có thể xuất hiện trong Pháo Đài Nether."
	]
	quest.07D69899C52591E9.quest_subtitle: "Chúa tể lửa"
	quest.07D69899C52591E9.title: "Đánh bại Hoả Ma"
	quest.07E64C0B306DB76F.quest_desc: [
		"Để tiến hoá thành Ma Vương, bạn cần thu thập 10.000 linh hồn. Có thể nhận linh hồn bằng cách tiêu diệt các sinh vật. Sinh vật có EP càng cao thì càng cho nhiều linh hồn."
		""
		"&lĐặc tính sau tiến hoá&r"
		"Nhận thêm EP &4gấp 3 lần&r"
		"Chỉ số đồng minh &btăng gấp đôi&r"
		"Một số NPC đồng minh sẽ tiến hoá"
		"Mọi &5Tiến Hoá Kháng Tính&r áp dụng đều bị vô hiệu"
		""
		"&6Nhắc nhẹ: Bạn có thể tích luỹ thật nhiều EP trước, rồi mới tiến hoá thành Ma Vương khi thấy phù hợp để tận dụng tối đa lợi ích nhé~&r"
		""
		"Trước khi thức tỉnh, người chơi sẽ trải qua &6“Lễ Hội Thu Hoạch”&r kéo dài 3 phút:"
		""
		"Trong phút đầu, người chơi không thể dùng kỹ năng, tầm nhìn và khả năng di chuyển bị hạn chế; toàn bộ thuộc hạ trong phạm vi tự chuyển sang trạng thái \"Đi Theo và Bảo Vệ\"."
		""
		"Bước sang phút thứ 2, người chơi lập tức rơi vào \"giấc ngủ\"."
		""
		"Trong phút cuối, thuộc hạ và ma vật tuỳ tùng trong phạm vi cũng tự rơi vào \"giấc ngủ\"."
		"Khi nghi thức gần kết thúc, âm thanh và hiệu ứng hình ảnh tăng dần; trong 10 giây cuối, người chơi bắt đầu chớp sáng rồi từ từ bay lên cho đến khi thức tỉnh hoàn tất."
	]
	quest.07E64C0B306DB76F.quest_subtitle: "Diệt!"
	quest.07E64C0B306DB76F.title: "&6【Con Đường Ma Vương】&rĐiều kiện trở thành Ma Vương"
	quest.080F3F29AE3A1EDF.quest_desc: "Có cơ hội nhận được khi tiêu diệt ác ma ở Minh Giới hoặc từ rương trong Nether"
	quest.080F3F29AE3A1EDF.quest_subtitle: "Cách thu thập"
	quest.0813F465C4661060.title: "Taratect Độc Cỡ Nhỏ"
	quest.0831BD175FEF3A79.quest_desc: [
		"&l&6Trước hết, chỉnh &4&lba ô kỹ năng&6&l bên trái. Nếu chúng bị khuất, hãy mở &4&lbảng thông tin cá nhân (phím B)&6&l rồi nhấn nút bánh răng ở góc trên bên phải.&r"
		"{image:ablazeaqzlcz:textures/ftb/interface.png width:145 height:100 align:center}"
	]
	quest.0831BD175FEF3A79.quest_subtitle: "Vị trí giao diện (không vướng thì không cần chỉnh)"
	quest.0831BD175FEF3A79.title: "Bước một: Điều chỉnh màn hình"
	quest.084FC80D83382D73.quest_subtitle: "Pháo đài ngầm nằm bên trong [Chọn một tuyến; người chơi đơn có thể thử thách tất cả]"
	quest.08622D8C9E96691E.quest_desc: [
		"&6EP mặc định: 0"
		"&6Tiêu diệt sinh vật có thể tăng EP, nhưng không thể tiến hoá."
	]
	quest.08622D8C9E96691E.quest_subtitle: "Ex"
	quest.08889BAAC91E4DA2.quest_subtitle: "Linh thú xuất hiện ở Núi và Rừng Hoa"
	quest.08889BAAC91E4DA2.title: "Kỳ lân ư?"
	quest.0911C58D43476BEB.quest_desc: ["Có thể tìm nhà của cự nhân gần biển. Nó trông như một gò đá hình bán nguyệt, bên trong có rất nhiều cừu con."]
	quest.0911C58D43476BEB.title: "Thảo phạt Độc Nhãn Cự Nhân"
	quest.095FE2716CDAB6DE.title: "Quỷ Ăn Thịt Người"
	quest.0965ACAFAF2FD521.quest_desc: "Thường xuất hiện trong rương tại tàn tích, đền thờ hoặc &#FFB353kho báu theo bản đồ bãi biển&r"
	quest.0965ACAFAF2FD521.quest_subtitle: "Vật phẩm độc quyền trong rương báu?"
	quest.0983787012437700.quest_desc: [
		"Thu được nhiều chiến lợi phẩm hơn"
		"&6&lBội Thu【Mở khoá Bách Khoa】"
		"{image:ablazeaqzlcz:textures/ftb/curios/anglers_hat.png width:50 height:80 align:left}"
	]
	quest.09DE7BCAEBDBDE56.quest_desc: [
		"1. Yêu cầu thông thạo Vô Hạn Lao Ngục (không mất kỹ năng này khi tiến hoá);"
		"2. Yêu cầu 2.000.000 Ma Tố, sẽ bị tiêu hao khi tiến hoá;"
		"3. Yêu cầu trở thành Chân Anh Hùng hoặc Chân Ma Vương."
	]
	quest.09DE7BCAEBDBDE56.quest_subtitle: "Điều kiện↓"
	quest.09DE7BCAEBDBDE56.title: "&6【Nâng Cao】&fKỹ năng Tối thượng Kronairos, Vô Tận Chi Vương"
	quest.0A032BF14B496525.quest_subtitle: "【Thông Thạo】"
	quest.0A032BF14B496525.title: "&6【Nâng Cao】&fSở hữu Kỹ năng Độc nhất Satella"
	quest.0A78354A482CA2D2.quest_desc: [
		"Chế tạo ba lô để mở rộng kho đồ. Có thể đeo ba lô ở ô phụ kiện và dùng phím tắt &6(H)&r để mở."
		"Tiêu diệt ma vật để tích luỹ EP và nâng cấp ba lô thành Ba Lô Kim Loại Tối Thượng!"
	]
	quest.0A78354A482CA2D2.quest_subtitle: "Không chịu nổi nữa rồi..."
	quest.0A78354A482CA2D2.title: "&6【Nhiệm Vụ Phụ】&rNày, tôi hết chứa nổi rồi"
	quest.0AF699444809DBDD.quest_desc: "Vật phẩm này có sức chứa gấp ba Kho Linh Khí, giúp lưu trữ một lượng lớn linh khí."
	quest.0AF699444809DBDD.quest_subtitle: "Tích trữ thêm linh khí"
	quest.0B45B06246AC854D.quest_desc: [
		"&lĐể chế tạo vũ khí này, bạn cần:&r"
		"{\"text\": \"Bàn Rèn\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"5E173415DC087BC4\"}}"
		""
		"Đồng thời mở khoá bản thiết kế ma trượng"
		""
		"Tiến hoá đặc biệt: Có 3 giai đoạn tiến hoá riêng biệt, mỗi lần đều tăng sát thương công kích"
		"52000 EP: Sát thương công kích +13"
		"225000 EP: Sát thương công kích +15"
		"750000 EP: Sát thương công kích +29"
	]
	quest.0B45B06246AC854D.quest_subtitle: "Chuột phải triệu hồi, chuột trái tấn công, chiến binh pháp sư sao?"
	quest.0B45B06246AC854D.title: "&6【Săn Boss①】&rTriệu hồi quân đoàn Slime"
	quest.0B5F248E6E8FB4FE.quest_desc: [
		"Hoạt động tương tự Mắt Ender, giúp tìm công trình nơi Boss trú ngụ"
		""
		"&6Hoa Tinh Quang dễ tìm hơn trong Rừng Tinh Quang hoặc Bụi Rậm Tinh Quang.&r"
	]
	quest.0B5F248E6E8FB4FE.quest_subtitle: "Tìm Xưởng Đúc Khôi Lỗi và Khu Vườn Nguyền Rủa"
	quest.0B625F1182B5E4A4.quest_subtitle: "Không có nồi thì xào nấu kiểu gì?"
	quest.0B62BEC857573993.quest_subtitle: "Yếu hơn Giáp Kim Cương một chút"
	quest.0B62BEC857573993.title: "Bộ Giáp Bạo Phong Đại Xà"
	quest.0B958A2BBD37292D.quest_desc: [
		"Giữ chuột phải khi đối mặt kẻ địch; cũng có thể dùng chuột trái để đốn cây. Vừa là vũ khí, vừa là công cụ."
		"&6EP mặc định: 0"
		"&6Tiêu diệt sinh vật có thể tăng EP, nhưng vũ khí không thể tiến hoá."
	]
	quest.0B958A2BBD37292D.quest_subtitle: "Nghiền nát chúng"
	quest.0B992C3C64DCBDFD.quest_subtitle: "Cổ thụ làm tăng linh khí"
	quest.0B992C3C64DCBDFD.title: "Bổ sung linh khí cho môi trường xung quanh!"
	quest.0BC3C85CABC897FD.quest_desc: [
		"Khi tiêu diệt sinh vật, người chơi nhận 3% EP của nó. Nếu sở hữu các kỹ năng như Kẻ Săn Mồi và Đại Hiền Giả, bạn có thể thu được nhiều EP hơn, đồng thời đoạt lấy kỹ năng của sinh vật đó."
		"&5Với chủng tộc phi ma vật, 2/3 EP nhận được chuyển thành AP (Đấu Khí), 1/3 còn lại thành MP (Ma Tố)&r. &bVới ma vật, 2/3 chuyển thành MP (Ma Tố), còn 1/3 thành AP (Đấu Khí).&r"
		""
		"Nếu chọn chủng tộc có chỉ số khởi đầu cao thì việc này chắc dễ thôi..."
	]
	quest.0BC3C85CABC897FD.quest_subtitle: "Làm sao kiếm EP nhanh?"
	quest.0BC3C85CABC897FD.title: "&6【Cốt Truyện Chính】&rĐạt 3000 EP"
	quest.0BD750F86B0EA265.title: "{translate:\"task.A1F2E3D4C5B60198.title\"}"
	quest.0BE594C503C526D1.quest_desc: ["Lông Quạ rơi từ quạ, thường xuất hiện gần các cột hắc diện thạch."]
	quest.0BE594C503C526D1.quest_subtitle: "Bản đồ ma pháp!"
	quest.0BE594C503C526D1.title: "[Tuỳ chọn] Chế tạo bản đồ xác định vị trí công trình của Boss"
	quest.0BEDF37489C0CD4D.quest_desc: ["&6EP mặc định: 2000, không thể tiến hoá"]
	quest.0BEDF37489C0CD4D.quest_subtitle: "Ngọn lửa cuồng nộ"
	quest.0C345577043D3630.title: "Giúp rồng mau lớn!"
	quest.0C5CB0025C8F81AC.quest_desc: "Nhấp chuột phải vào Thánh Thuẫn để nhận hiệu ứng 10 phút: giảm thời gian đóng băng, giảm sát thương đạn mạc, ngăn Boss hồi máu và chặn dịch chuyển cưỡng ép. Có thể chiến đấu mà không dùng Thánh Thuẫn, nhưng độ khó sẽ gần mức tối đa."
	quest.0CAB66227F82B28F.quest_desc: [
		"Tra Sách Linh Khí Tự Nhiên, rồi đặt Bàn Hiến Tế cùng 36 bông hoa nhỏ bất kỳ (nên đặt ngoài trời thoáng đãng!)."
		""
		"Cần có Linh Thể Triệu Gọi để sử dụng Bàn Hiến Tế!"
		"Nhấp chuột phải vào bát bằng nguyên liệu, lùi một bước rồi ném Linh Thể Triệu Gọi vào vòng hoa. Chờ một lát, “sét” sẽ mang lễ vật đi; nguyên liệu sẽ rơi từ trời xuống sau đó."
	]
	quest.0CAB66227F82B28F.quest_subtitle: "Thần linh ơi, hãy chứng giám"
	quest.0D1E2F3A4B5C6789.title: "{translate:\"task.0D1E2F3A4B5C6780.title\"}"
	quest.0D960805EE9F7AA5.quest_desc: [
		"Để đánh thức Harbinger đang ngủ, trước tiên hãy đánh bại Wither để lấy Sao Nether, rồi cầm nó nhấp chuột phải vào Harbinger."
		"Nó có hai giai đoạn như Wither; ở giai đoạn hai, sát thương công kích tăng lên."
		""
		"&6Kỹ năng sở hữu: Vô Hiệu Công Kích Nhiệt, Vô Hiệu Ăn Mòn, Vô Hiệu Trạng Thái Bất Thường, Vô Hiệu Công Kích Phong, Cường Hoá Cơ Thể, Cường Hoá Cương Thép và Tái Sinh Siêu Tốc"
	]
	quest.0D960805EE9F7AA5.quest_subtitle: "Trí tuệ của người xưa"
	quest.0D960805EE9F7AA5.title: "Thảo phạt Harbinger"
	quest.0DA9EA203D43A4E0.title: "Mảnh tinh thể hốc đá"
	quest.0E105E703E79C81B.quest_desc: ["Động cơ Ma Pháp thường ngăn ma vật sinh ra trong bán kính 16 khối. Động cơ Ma Pháp Mê Cung có phạm vi 32 khối."]
	quest.0E105E703E79C81B.quest_subtitle: "Giảm nồng độ Ma Tố xung quanh"
	quest.0E105E703E79C81B.title: "Đừng để ma vật đến gần ta"
	quest.0E185842079057DA.quest_subtitle: "【Thông Thạo】"
	quest.0E185842079057DA.title: "&6【Nâng Cao】&fSở hữu Kỹ năng Độc nhất Xạ Thủ"
	quest.0E2CFFE14441FB44.quest_desc: ["Sau khi giết rồng, dùng tay không nhấp chuột phải vào xác rồng để lấy."]
	quest.0E2CFFE14441FB44.quest_subtitle: "Thu thập từ xác rồng"
	quest.0E40614E1212A8E7.quest_desc: [
		"Cố lên! Giết vài con ma vật dễ thôi mà."
		"Đây là bước ngoặt. Đạt 6.000 rồi thì chắc bạn đã mở được vài kỹ năng nhỉ? Hãy tìm và học những kỹ năng phù hợp!"
		""
	]
	quest.0E40614E1212A8E7.title: "&6【Cốt Truyện Chính】&rĐạt 5000 EP"
	quest.0E4A2C7FB4B21F4F.quest_desc: ["Hồi 10% MP sau khi uống"]
	quest.0E4A2C7FB4B21F4F.quest_subtitle: "Nhận từ người lùn giả kim"
	quest.0E4E2A348018B02E.quest_desc: [
		"&8Thuở xa xưa, có hai chủng tộc thống trị Thế Giới Thường."
		"&8Một ngày nọ, chiến tranh nổ ra giữa họ rồi nhanh chóng kết thúc. Để diệt tận gốc đối thủ, bên chiến thắng cử các pháp sư hùng mạnh xé rách không gian, tạo ra một bản sao của thế giới chính, giam cầm kẻ bại trận bên trong và giáng xuống vô số lời nguyền..."
		"&8Do lời nguyền, thời gian nơi này vĩnh viễn dừng ở hoàng hôn, các vì sao dần lụi tắt, dòng ether đổ xuống từ trời. Có lẽ tai hoạ đã khơi dậy khát vọng sống, cũng có lẽ hình phạt làm thù hận thêm sâu. Những kẻ lưu đày không diệt vong mà xây dựng nền văn minh riêng. Họ tự xưng là \"Tinh Quang Tộc\", dốc sức nghiên cứu ma pháp, chờ ngày trở lại..."
		"&8Cuối cùng, cự nhân ngã xuống, nhưng tổn thất không thể vãn hồi. Tinh Quang Tộc đánh cược tất cả, dùng ma pháp cổ đại mở cổng về thế giới chính. Dường như họ đã thành công: một cánh cửa đen toả ánh tím mở ra. Không kịp nghĩ ngợi, những người sống sót ùa vào..."
		"&8Một số loài cây chịu ảnh hưởng của ma pháp, mang nguyên tố ma lực và trở nên khác xa tổ tiên chúng.&r"
	]
	quest.0E4E2A348018B02E.quest_subtitle: "\"Bản sao của thế giới chính\""
	quest.0E557D8BB429060D.title: "{translate:\"task.EE5F6A7B8C9D0124.title\"}"
	quest.0E80325865685EE6.quest_desc: [
		"[{\"text\": \"Trước hết hãy tìm hiểu hệ thống danh vọng\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"56413501A9E9D8FC\"}}]"
		""
		"Khi DR đạt -100 hoặc 100, bạn có thể dùng Phiến Đá Dịch Chuyển trong Tháp Hoàng Gia để đến trận chiến Boss Gazel Dwargo."
		""
		"&6Khi đạt -100 DR"
		"Bạn sẽ dùng Phiến Đá Dịch Chuyển với thân phận tội phạm và bị đích thân Quốc Vương xử quyết. Phải đánh bại Gazel Dwargo để nhận Bí Kíp Ngũ Hoa Trảm. Sau đó, bạn không thể dùng phiến đá này nữa."
		""
		"&6Khi đạt 100 DR&r"
		"Bạn sẽ đến với tư cách bằng hữu của Vương Quốc Người Lùn và được Quốc Vương đích thân tiếp đón. Có thể xem đây là một trận luyện tập; thắng trận, ông sẽ tặng Ngũ Hoa Trảm. Sau khi thắng, bạn vẫn có thể quay lại khiêu chiến."
	]
	quest.0E80325865685EE6.title: "Khiêu chiến Vua Người Lùn"
	quest.0F3129D294DAFC1B.quest_desc: [
		"Nhấp chuột phải vào rồng nở từ trứng để ra lệnh ngồi, đứng hoặc đi theo"
		"Ngồi xuống và nhấp chuột phải vào rồng để đặt nhà của nó tại toạ độ hiện tại."
	]
	quest.0F3129D294DAFC1B.quest_subtitle: "Điều khiển rồng của bạn"
	quest.0F4B54C71BF36F07.title: "&6【Nâng Cao】&fSở hữu Kỹ năng Độc nhất Phẫn Nộ"
	quest.0FBF8D0B672B3247.quest_desc: [
		"&8Trước khi chiến đấu, hãy chuẩn bị:"
		"Quan trọng nhất là những thứ sau:"
		"&8Thật nhiều vật phẩm hồi máu"
		"Phần lớn sát thương của nó là sát thương chuẩn, nên giáp và giảm sát thương gần như vô dụng."
		"&8Một chiếc rìu"
		"Chuyên dùng để phá Tinh Thể Từ Bi."
		"&8Tránh mang vật phẩm bay hoặc nhảy đôi"
		"Do \"vùng trời ion hoá\", bạn liên tục mất máu khi bay cao và có thể đột tử khi máu thấp."
	]
	quest.0FBF8D0B672B3247.quest_subtitle: "Những điều cần biết"
	quest.0FC666681CCE2617.title: "{translate:\"task.CC3D4E5F6A7B8902.title\"}"
	quest.0FDA8DE439A0FC25.quest_desc: [
		"[Năng Lượng Linh Hồn] được xác định ngẫu nhiên khi lần đầu vào thế giới và không thể tuỳ ý sửa đổi về sau. Chỉ có thể tăng nó bằng những hành động đặc biệt trong quá trình chơi."
		"Mỗi lần nhận một năng lực Độc nhất mới, bạn sẽ tiêu hao Năng Lượng Linh Hồn tương ứng với sức mạnh của kỹ năng đó."
	]
	quest.0FDA8DE439A0FC25.quest_subtitle: "Yếu tố quan trọng khi học năng lực Độc nhất"
	quest.0FDA8DE439A0FC25.title: "Hệ thống Năng Lượng Linh Hồn"
	quest.101F636AC88EA48C.quest_desc: [
		"Muốn sống sót ở thế giới này, bạn phải mạnh hơn. Trước tiên hãy thử săn vài con ma vật."
		""
		"Có thể thu Da Ma Vật bằng cách tiêu diệt &lThằn Lằn, Khuyển Ma, Nha Lang&r và các sinh vật khác ngoài tự nhiên"
		"Bóng Slime rơi khi tiêu diệt Slime &l(xuất hiện nhiều hơn trong rừng hoặc đồng bằng)&r"
		""
		"Gì cơ? Chủng tộc của bạn quá yếu, không đánh nổi à? Đừng lo, dùng \"thuyền\" để giữ chúng lại."
	]
	quest.101F636AC88EA48C.quest_subtitle: "Thu thập tài nguyên ban đầu!"
	quest.101F636AC88EA48C.title: "&6【Cốt Truyện Chính】&rTiêu diệt ma vật"
	quest.1046211A6B00FE3A.quest_subtitle: "Chế biến món ăn chứa Ma Tố!"
	quest.1048338B290654F5.quest_subtitle: "Di tích chôn vùi dưới lòng đất"
	quest.1048338B290654F5.title: "Tìm Đấu Trường Từ Bi"
	quest.10BF630559FD74EA.quest_desc: ["&6EP mặc định: 2000, không thể tiến hoá"]
	quest.11783FF7C73C9DC3.quest_desc: [
